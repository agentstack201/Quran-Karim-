# Tilawa — environment variables
#
# Every variable here is optional. The application runs correctly with none of
# them set, which is deliberate: a Quran reader should not need configuration to
# work.

# Canonical origin, used for absolute URLs in metadata, the sitemap, JSON-LD and
# share links. Set this when deploying to your own domain — otherwise those URLs
# point at the default and search engines will index the wrong host.
#
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tilawa.app
