{"chapter":{"id":74,"name":"المُدثر","nameSimple":"المدثر","transliteration":"Al-Muddaththir","translation":"The Cloaked One","revelation":"meccan","revelationOrder":4,"versesCount":56,"rukuCount":2,"firstVerseId":5496,"lastVerseId":5551,"startPage":575,"endPage":577,"startJuz":29,"endJuz":29,"hasBasmalah":true},"verses":[{"id":5496,"surah":74,"ayah":1,"key":"74:1","numberInSurah":"١","text":"يَـٰٓأَيُّهَا ٱلۡمُدَّثِّرُ","transliteration":"Ya ayyuha almuddaththiru","translation":"O you who covers himself [with a garment]","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5497,"surah":74,"ayah":2,"key":"74:2","numberInSurah":"٢","text":"قُمۡ فَأَنذِرۡ","transliteration":"Qum faanthir","translation":"Arise and warn","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5498,"surah":74,"ayah":3,"key":"74:3","numberInSurah":"٣","text":"وَرَبَّكَ فَكَبِّرۡ","transliteration":"Warabbaka fakabbir","translation":"And your Lord glorify","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5499,"surah":74,"ayah":4,"key":"74:4","numberInSurah":"٤","text":"وَثِيَابَكَ فَطَهِّرۡ","transliteration":"Wathiyabaka fatahhir","translation":"And your clothing purify","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5500,"surah":74,"ayah":5,"key":"74:5","numberInSurah":"٥","text":"وَٱلرُّجۡزَ فَٱهۡجُرۡ","transliteration":"Waalrrujza faohjur","translation":"And uncleanliness avoid","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5501,"surah":74,"ayah":6,"key":"74:6","numberInSurah":"٦","text":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ","transliteration":"Wala tamnun tastakthiru","translation":"And do not confer favor to acquire more","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5502,"surah":74,"ayah":7,"key":"74:7","numberInSurah":"٧","text":"وَلِرَبِّكَ فَٱصۡبِرۡ","transliteration":"Walirabbika faisbir","translation":"But for your Lord be patient","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5503,"surah":74,"ayah":8,"key":"74:8","numberInSurah":"٨","text":"فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ","transliteration":"Faitha nuqira fee alnnaqoori","translation":"And when the trumpet is blown","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5504,"surah":74,"ayah":9,"key":"74:9","numberInSurah":"٩","text":"فَذَٰلِكَ يَوۡمَئِذٖ يَوۡمٌ عَسِيرٌ","transliteration":"Fathalika yawmaithin yawmun AAaseerun","translation":"That Day will be a difficult day","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5505,"surah":74,"ayah":10,"key":"74:10","numberInSurah":"١٠","text":"عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرٖ","transliteration":"AAala alkafireena ghayru yaseerin","translation":"For the disbelievers - not easy","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5506,"surah":74,"ayah":11,"key":"74:11","numberInSurah":"١١","text":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا","transliteration":"Tharnee waman khalaqtu waheedan","translation":"Leave Me with the one I created alone","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5507,"surah":74,"ayah":12,"key":"74:12","numberInSurah":"١٢","text":"وَجَعَلۡتُ لَهُۥ مَالٗا مَّمۡدُودٗا","transliteration":"WajaAAaltu lahu malan mamdoodan","translation":"And to whom I granted extensive wealth","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5508,"surah":74,"ayah":13,"key":"74:13","numberInSurah":"١٣","text":"وَبَنِينَ شُهُودٗا","transliteration":"Wabaneena shuhoodan","translation":"And children present [with him]","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5509,"surah":74,"ayah":14,"key":"74:14","numberInSurah":"١٤","text":"وَمَهَّدتُّ لَهُۥ تَمۡهِيدٗا","transliteration":"Wamahhadtu lahu tamheedan","translation":"And spread [everything] before him, easing [his life]","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5510,"surah":74,"ayah":15,"key":"74:15","numberInSurah":"١٥","text":"ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ","transliteration":"Thumma yatmaAAu an azeeda","translation":"Then he desires that I should add more","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5511,"surah":74,"ayah":16,"key":"74:16","numberInSurah":"١٦","text":"كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدٗا","transliteration":"Kalla innahu kana liayatina AAaneedan","translation":"No! Indeed, he has been toward Our verses obstinate","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5512,"surah":74,"ayah":17,"key":"74:17","numberInSurah":"١٧","text":"سَأُرۡهِقُهُۥ صَعُودًا","transliteration":"Saorhiquhu saAAoodan","translation":"I will cover him with arduous torment","page":575,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5513,"surah":74,"ayah":18,"key":"74:18","numberInSurah":"١٨","text":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","transliteration":"Innahu fakkara waqaddara","translation":"Indeed, he thought and deliberated","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5514,"surah":74,"ayah":19,"key":"74:19","numberInSurah":"١٩","text":"فَقُتِلَ كَيۡفَ قَدَّرَ","transliteration":"Faqutila kayfa qaddara","translation":"So may he be destroyed [for] how he deliberated","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5515,"surah":74,"ayah":20,"key":"74:20","numberInSurah":"٢٠","text":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ","transliteration":"Thumma qutila kayfa qaddara","translation":"Then may he be destroyed [for] how he deliberated","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5516,"surah":74,"ayah":21,"key":"74:21","numberInSurah":"٢١","text":"ثُمَّ نَظَرَ","transliteration":"Thumma nathara","translation":"Then he considered [again]","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5517,"surah":74,"ayah":22,"key":"74:22","numberInSurah":"٢٢","text":"ثُمَّ عَبَسَ وَبَسَرَ","transliteration":"Thumma AAabasa wabasara","translation":"Then he frowned and scowled","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5518,"surah":74,"ayah":23,"key":"74:23","numberInSurah":"٢٣","text":"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ","transliteration":"Thumma adbara waistakbara","translation":"Then he turned back and was arrogant","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5519,"surah":74,"ayah":24,"key":"74:24","numberInSurah":"٢٤","text":"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ يُؤۡثَرُ","transliteration":"Faqala in hatha illa sihrun yutharu","translation":"And said, \"This is not but magic imitated [from others]","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5520,"surah":74,"ayah":25,"key":"74:25","numberInSurah":"٢٥","text":"إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ","transliteration":"In hatha illa qawlu albashari","translation":"This is not but the word of a human being","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5521,"surah":74,"ayah":26,"key":"74:26","numberInSurah":"٢٦","text":"سَأُصۡلِيهِ سَقَرَ","transliteration":"Saosleehi saqara","translation":"I will drive him into Saqar","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5522,"surah":74,"ayah":27,"key":"74:27","numberInSurah":"٢٧","text":"وَمَآ أَدۡرَىٰكَ مَا سَقَرُ","transliteration":"Wama adraka ma saqaru","translation":"And what can make you know what is Saqar","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5523,"surah":74,"ayah":28,"key":"74:28","numberInSurah":"٢٨","text":"لَا تُبۡقِي وَلَا تَذَرُ","transliteration":"La tubqee wala tatharu","translation":"It lets nothing remain and leaves nothing [unburned]","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5524,"surah":74,"ayah":29,"key":"74:29","numberInSurah":"٢٩","text":"لَوَّاحَةٞ لِّلۡبَشَرِ","transliteration":"Lawwahatun lilbashari","translation":"Blackening the skins","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5525,"surah":74,"ayah":30,"key":"74:30","numberInSurah":"٣٠","text":"عَلَيۡهَا تِسۡعَةَ عَشَرَ","transliteration":"AAalayha tisAAata AAashara","translation":"Over it are nineteen [angels]","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5526,"surah":74,"ayah":31,"key":"74:31","numberInSurah":"٣١","text":"وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةٗۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةٗ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنٗا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ","transliteration":"Wama jaAAalna ashaba alnnari illa malaikatan wama jaAAalna AAiddatahum illa fitnatan lillatheena kafaroo liyastayqina allatheena ootoo alkitaba wayazdada allatheena amanoo eemanan wala yartaba allatheena ootoo alkitaba waalmuminoona waliyaqoola allatheena fee quloobihim maradun waalkafiroona matha arada Allahu bihatha mathalan kathalika yudillu Allahu man yashao wayahdee man yashao wama yaAAlamu junooda rabbika illa huwa wama hiya illa thikra lilbashari","translation":"And We have not made the keepers of the Fire except angels. And We have not made their number except as a trial for those who disbelieve - that those who were given the Scripture will be convinced and those who have believed will increase in faith and those who were given the Scripture and the believers will not doubt and that those in whose hearts is hypocrisy and the disbelievers will say, \"What does Allah intend by this as an example?\" Thus does Allah leave astray whom He wills and guides whom He wills. And none knows the soldiers of your Lord except Him. And mention of the Fire is not but a reminder to humanity","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":510,"sajdah":false},{"id":5527,"surah":74,"ayah":32,"key":"74:32","numberInSurah":"٣٢","text":"كَلَّا وَٱلۡقَمَرِ","transliteration":"Kalla waalqamari","translation":"No! By the moon","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5528,"surah":74,"ayah":33,"key":"74:33","numberInSurah":"٣٣","text":"وَٱلَّيۡلِ إِذۡ أَدۡبَرَ","transliteration":"Waallayli ith adbara","translation":"And [by] the night when it departs","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5529,"surah":74,"ayah":34,"key":"74:34","numberInSurah":"٣٤","text":"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ","transliteration":"Waalssubhi itha asfara","translation":"And [by] the morning when it brightens","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5530,"surah":74,"ayah":35,"key":"74:35","numberInSurah":"٣٥","text":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ","transliteration":"Innaha laihda alkubari","translation":"Indeed, the Fire is of the greatest [afflictions]","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5531,"surah":74,"ayah":36,"key":"74:36","numberInSurah":"٣٦","text":"نَذِيرٗا لِّلۡبَشَرِ","transliteration":"Natheeran lilbashari","translation":"As a warning to humanity","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5532,"surah":74,"ayah":37,"key":"74:37","numberInSurah":"٣٧","text":"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ","transliteration":"Liman shaa minkum an yataqaddama aw yataakhkhara","translation":"To whoever wills among you to proceed or stay behind","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5533,"surah":74,"ayah":38,"key":"74:38","numberInSurah":"٣٨","text":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ","transliteration":"Kullu nafsin bima kasabat raheenatun","translation":"Every soul, for what it has earned, will be retained","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5534,"surah":74,"ayah":39,"key":"74:39","numberInSurah":"٣٩","text":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ","transliteration":"Illa ashaba alyameeni","translation":"Except the companions of the right","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5535,"surah":74,"ayah":40,"key":"74:40","numberInSurah":"٤٠","text":"فِي جَنَّـٰتٖ يَتَسَآءَلُونَ","transliteration":"Fee jannatin yatasaaloona","translation":"[Who will be] in gardens, questioning each other","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5536,"surah":74,"ayah":41,"key":"74:41","numberInSurah":"٤١","text":"عَنِ ٱلۡمُجۡرِمِينَ","transliteration":"AAani almujrimeena","translation":"About the criminals","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5537,"surah":74,"ayah":42,"key":"74:42","numberInSurah":"٤٢","text":"مَا سَلَكَكُمۡ فِي سَقَرَ","transliteration":"Ma salakakum fee saqara","translation":"[And asking them], \"What put you into Saqar","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5538,"surah":74,"ayah":43,"key":"74:43","numberInSurah":"٤٣","text":"قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ","transliteration":"Qaloo lam naku mina almusalleena","translation":"They will say, \"We were not of those who prayed","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5539,"surah":74,"ayah":44,"key":"74:44","numberInSurah":"٤٤","text":"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ","transliteration":"Walam naku nutAAimu almiskeena","translation":"Nor did we used to feed the poor","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5540,"surah":74,"ayah":45,"key":"74:45","numberInSurah":"٤٥","text":"وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ","transliteration":"Wakunna nakhoodu maAAa alkhaideena","translation":"And we used to enter into vain discourse with those who engaged [in it]","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5541,"surah":74,"ayah":46,"key":"74:46","numberInSurah":"٤٦","text":"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ","transliteration":"Wakunna nukaththibu biyawmi alddeeni","translation":"And we used to deny the Day of Recompense","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5542,"surah":74,"ayah":47,"key":"74:47","numberInSurah":"٤٧","text":"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ","transliteration":"Hatta atana alyaqeenu","translation":"Until there came to us the certainty","page":576,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5543,"surah":74,"ayah":48,"key":"74:48","numberInSurah":"٤٨","text":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّـٰفِعِينَ","transliteration":"Fama tanfaAAuhum shafaAAatu alshshafiAAeena","translation":"So there will not benefit them the intercession of [any] intercessors","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5544,"surah":74,"ayah":49,"key":"74:49","numberInSurah":"٤٩","text":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ","transliteration":"Fama lahum AAani alttathkirati muAArideena","translation":"Then what is [the matter] with them that they are, from the reminder, turning away","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5545,"surah":74,"ayah":50,"key":"74:50","numberInSurah":"٥٠","text":"كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ","transliteration":"Kaannahum humurun mustanfiratun","translation":"As if they were alarmed donkeys","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5546,"surah":74,"ayah":51,"key":"74:51","numberInSurah":"٥١","text":"فَرَّتۡ مِن قَسۡوَرَةِۭ","transliteration":"Farrat min qaswaratin","translation":"Fleeing from a lion","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5547,"surah":74,"ayah":52,"key":"74:52","numberInSurah":"٥٢","text":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ","transliteration":"Bal yureedu kullu imriin minhum an yuta suhufan munashsharatan","translation":"Rather, every person among them desires that he would be given scriptures spread about","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5548,"surah":74,"ayah":53,"key":"74:53","numberInSurah":"٥٣","text":"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ","transliteration":"Kalla bal la yakhafoona alakhirata","translation":"No! But they do not fear the Hereafter","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5549,"surah":74,"ayah":54,"key":"74:54","numberInSurah":"٥٤","text":"كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ","transliteration":"Kalla innahu tathkiratun","translation":"No! Indeed, the Qur'an is a reminder","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5550,"surah":74,"ayah":55,"key":"74:55","numberInSurah":"٥٥","text":"فَمَن شَآءَ ذَكَرَهُۥ","transliteration":"Faman shaa thakarahu","translation":"Then whoever wills will remember it","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false},{"id":5551,"surah":74,"ayah":56,"key":"74:56","numberInSurah":"٥٦","text":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ","transliteration":"Wama yathkuroona illa an yashaa Allahu huwa ahlu alttaqwa waahlu almaghfirati","translation":"And they will not remember except that Allah wills. He is worthy of fear and adequate for [granting] forgiveness","page":577,"juz":29,"hizb":58,"rubAlHizb":230,"ruku":511,"sajdah":false}]}
