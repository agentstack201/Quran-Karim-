{"chapter":{"id":111,"name":"المَسَد","nameSimple":"المسد","transliteration":"Al-Masad","translation":"The Palm Fiber","revelation":"meccan","revelationOrder":6,"versesCount":5,"rukuCount":1,"firstVerseId":6217,"lastVerseId":6221,"startPage":603,"endPage":603,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6217,"surah":111,"ayah":1,"key":"111:1","numberInSurah":"١","text":"تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ","transliteration":"Tabbat yada abee lahabin watabba","translation":"May the hands of Abu Lahab be ruined, and ruined is he","page":603,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":553,"sajdah":false},{"id":6218,"surah":111,"ayah":2,"key":"111:2","numberInSurah":"٢","text":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","transliteration":"Ma aghna AAanhu maluhu wama kasaba","translation":"His wealth will not avail him or that which he gained","page":603,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":553,"sajdah":false},{"id":6219,"surah":111,"ayah":3,"key":"111:3","numberInSurah":"٣","text":"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ","transliteration":"Sayasla naran thata lahabin","translation":"He will [enter to] burn in a Fire of [blazing] flame","page":603,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":553,"sajdah":false},{"id":6220,"surah":111,"ayah":4,"key":"111:4","numberInSurah":"٤","text":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ","transliteration":"Waimraatuhu hammalata alhatabi","translation":"And his wife [as well] - the carrier of firewood","page":603,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":553,"sajdah":false},{"id":6221,"surah":111,"ayah":5,"key":"111:5","numberInSurah":"٥","text":"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ","transliteration":"Fee jeediha hablun min masadin","translation":"Around her neck is a rope of [twisted] fiber","page":603,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":553,"sajdah":false}]}
