{"chapter":{"id":87,"name":"الأعلى","nameSimple":"الأعلى","transliteration":"Al-A'la","translation":"The Most High","revelation":"meccan","revelationOrder":8,"versesCount":19,"rukuCount":1,"firstVerseId":5949,"lastVerseId":5967,"startPage":591,"endPage":592,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5949,"surah":87,"ayah":1,"key":"87:1","numberInSurah":"١","text":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","transliteration":"Sabbihi isma rabbika alaAAla","translation":"Exalt the name of your Lord, the Most High","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5950,"surah":87,"ayah":2,"key":"87:2","numberInSurah":"٢","text":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","transliteration":"Allathee khalaqa fasawwa","translation":"Who created and proportioned","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5951,"surah":87,"ayah":3,"key":"87:3","numberInSurah":"٣","text":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","transliteration":"Waallathee qaddara fahada","translation":"And who destined and [then] guided","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5952,"surah":87,"ayah":4,"key":"87:4","numberInSurah":"٤","text":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","transliteration":"Waallathee akhraja almarAAa","translation":"And who brings out the pasture","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5953,"surah":87,"ayah":5,"key":"87:5","numberInSurah":"٥","text":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","transliteration":"FajaAAalahu ghuthaan ahwa","translation":"And [then] makes it black stubble","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5954,"surah":87,"ayah":6,"key":"87:6","numberInSurah":"٦","text":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","transliteration":"Sanuqrioka fala tansa","translation":"We will make you recite, [O Muhammad], and you will not forget","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5955,"surah":87,"ayah":7,"key":"87:7","numberInSurah":"٧","text":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","transliteration":"Illa ma shaa Allahu innahu yaAAlamu aljahra wama yakhfa","translation":"Except what Allah should will. Indeed, He knows what is declared and what is hidden","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5956,"surah":87,"ayah":8,"key":"87:8","numberInSurah":"٨","text":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","transliteration":"Wanuyassiruka lilyusra","translation":"And We will ease you toward ease","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5957,"surah":87,"ayah":9,"key":"87:9","numberInSurah":"٩","text":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","transliteration":"Fathakkir in nafaAAati alththikra","translation":"So remind, if the reminder should benefit","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5958,"surah":87,"ayah":10,"key":"87:10","numberInSurah":"١٠","text":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","transliteration":"Sayaththakkaru man yakhsha","translation":"He who fears [Allah] will be reminded","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5959,"surah":87,"ayah":11,"key":"87:11","numberInSurah":"١١","text":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","transliteration":"Wayatajannabuha alashqa","translation":"But the wretched one will avoid it","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5960,"surah":87,"ayah":12,"key":"87:12","numberInSurah":"١٢","text":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","transliteration":"Allathee yasla alnnara alkubra","translation":"[He] who will [enter and] burn in the greatest Fire","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5961,"surah":87,"ayah":13,"key":"87:13","numberInSurah":"١٣","text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","transliteration":"Thumma la yamootu feeha wala yahya","translation":"Neither dying therein nor living","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5962,"surah":87,"ayah":14,"key":"87:14","numberInSurah":"١٤","text":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","transliteration":"Qad aflaha man tazakka","translation":"He has certainly succeeded who purifies himself","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5963,"surah":87,"ayah":15,"key":"87:15","numberInSurah":"١٥","text":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","transliteration":"Wathakara isma rabbihi fasalla","translation":"And mentions the name of his Lord and prays","page":591,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5964,"surah":87,"ayah":16,"key":"87:16","numberInSurah":"١٦","text":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","transliteration":"Bal tuthiroona alhayata alddunya","translation":"But you prefer the worldly life","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5965,"surah":87,"ayah":17,"key":"87:17","numberInSurah":"١٧","text":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","transliteration":"Waalakhiratu khayrun waabqa","translation":"While the Hereafter is better and more enduring","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5966,"surah":87,"ayah":18,"key":"87:18","numberInSurah":"١٨","text":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","transliteration":"Inna hatha lafee alssuhufi aloola","translation":"Indeed, this is in the former scriptures","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false},{"id":5967,"surah":87,"ayah":19,"key":"87:19","numberInSurah":"١٩","text":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","transliteration":"Suhufi ibraheema wamoosa","translation":"The scriptures of Abraham and Moses","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":529,"sajdah":false}]}
