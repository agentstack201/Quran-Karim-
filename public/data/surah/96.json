{"chapter":{"id":96,"name":"العَلَق","nameSimple":"العلق","transliteration":"Al-'Alaq","translation":"The Clot","revelation":"meccan","revelationOrder":1,"versesCount":19,"rukuCount":1,"firstVerseId":6107,"lastVerseId":6125,"startPage":597,"endPage":597,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6107,"surah":96,"ayah":1,"key":"96:1","numberInSurah":"١","text":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","transliteration":"Iqra biismi rabbika allathee khalaqa","translation":"Recite in the name of your Lord who created","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6108,"surah":96,"ayah":2,"key":"96:2","numberInSurah":"٢","text":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","transliteration":"Khalaqa alinsana min AAalaqin","translation":"Created man from a clinging substance","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6109,"surah":96,"ayah":3,"key":"96:3","numberInSurah":"٣","text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","transliteration":"Iqra warabbuka alakramu","translation":"Recite, and your Lord is the most Generous","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6110,"surah":96,"ayah":4,"key":"96:4","numberInSurah":"٤","text":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","transliteration":"Allathee AAallama bialqalami","translation":"Who taught by the pen","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6111,"surah":96,"ayah":5,"key":"96:5","numberInSurah":"٥","text":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","transliteration":"AAallama alinsana ma lam yaAAlam","translation":"Taught man that which he knew not","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6112,"surah":96,"ayah":6,"key":"96:6","numberInSurah":"٦","text":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","transliteration":"Kalla inna alinsana layatgha","translation":"No! [But] indeed, man transgresses","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6113,"surah":96,"ayah":7,"key":"96:7","numberInSurah":"٧","text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","transliteration":"An raahu istaghna","translation":"Because he sees himself self-sufficient","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6114,"surah":96,"ayah":8,"key":"96:8","numberInSurah":"٨","text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","transliteration":"Inna ila rabbika alrrujAAa","translation":"Indeed, to your Lord is the return","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6115,"surah":96,"ayah":9,"key":"96:9","numberInSurah":"٩","text":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","transliteration":"Araayta allathee yanha","translation":"Have you seen the one who forbids","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6116,"surah":96,"ayah":10,"key":"96:10","numberInSurah":"١٠","text":"عَبۡدًا إِذَا صَلَّىٰٓ","transliteration":"AAabdan itha salla","translation":"A servant when he prays","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6117,"surah":96,"ayah":11,"key":"96:11","numberInSurah":"١١","text":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","transliteration":"Araayta in kana AAala alhuda","translation":"Have you seen if he is upon guidance","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6118,"surah":96,"ayah":12,"key":"96:12","numberInSurah":"١٢","text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","transliteration":"Aw amara bialttaqwa","translation":"Or enjoins righteousness","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6119,"surah":96,"ayah":13,"key":"96:13","numberInSurah":"١٣","text":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","transliteration":"Araayta in kaththaba watawalla","translation":"Have you seen if he denies and turns away","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6120,"surah":96,"ayah":14,"key":"96:14","numberInSurah":"١٤","text":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","transliteration":"Alam yaAAlam bianna Allaha yara","translation":"Does he not know that Allah sees","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6121,"surah":96,"ayah":15,"key":"96:15","numberInSurah":"١٥","text":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","transliteration":"Kalla lain lam yantahi lanasfaAAan bialnnasiyati","translation":"No! If he does not desist, We will surely drag him by the forelock","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6122,"surah":96,"ayah":16,"key":"96:16","numberInSurah":"١٦","text":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","transliteration":"Nasiyatin kathibatin khatiatin","translation":"A lying, sinning forelock","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6123,"surah":96,"ayah":17,"key":"96:17","numberInSurah":"١٧","text":"فَلۡيَدۡعُ نَادِيَهُۥ","transliteration":"FalyadAAu nadiyahu","translation":"Then let him call his associates","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6124,"surah":96,"ayah":18,"key":"96:18","numberInSurah":"١٨","text":"سَنَدۡعُ ٱلزَّبَانِيَةَ","transliteration":"SanadAAu alzzabaniyata","translation":"We will call the angels of Hell","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":false},{"id":6125,"surah":96,"ayah":19,"key":"96:19","numberInSurah":"١٩","text":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","transliteration":"Kalla la tutiAAhu waosjud waiqtarib","translation":"No! Do not obey him. But prostrate and draw near [to Allah]","page":597,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":538,"sajdah":true}]}
