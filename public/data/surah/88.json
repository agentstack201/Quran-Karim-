{"chapter":{"id":88,"name":"الغَاشِية","nameSimple":"الغاشية","transliteration":"Al-Ghashiyah","translation":"The Overwhelming","revelation":"meccan","revelationOrder":68,"versesCount":26,"rukuCount":1,"firstVerseId":5968,"lastVerseId":5993,"startPage":592,"endPage":592,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5968,"surah":88,"ayah":1,"key":"88:1","numberInSurah":"١","text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","transliteration":"Hal ataka hadeethu alghashiyati","translation":"Has there reached you the report of the Overwhelming [event]","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5969,"surah":88,"ayah":2,"key":"88:2","numberInSurah":"٢","text":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","transliteration":"Wujoohun yawmaithin khashiAAatun","translation":"[Some] faces, that Day, will be humbled","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5970,"surah":88,"ayah":3,"key":"88:3","numberInSurah":"٣","text":"عَامِلَةٞ نَّاصِبَةٞ","transliteration":"AAamilatun nasibatun","translation":"Working [hard] and exhausted","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5971,"surah":88,"ayah":4,"key":"88:4","numberInSurah":"٤","text":"تَصۡلَىٰ نَارًا حَامِيَةٗ","transliteration":"Tasla naran hamiyatan","translation":"They will [enter to] burn in an intensely hot Fire","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5972,"surah":88,"ayah":5,"key":"88:5","numberInSurah":"٥","text":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","transliteration":"Tusqa min AAaynin aniyatin","translation":"They will be given drink from a boiling spring","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5973,"surah":88,"ayah":6,"key":"88:6","numberInSurah":"٦","text":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","transliteration":"Laysa lahum taAAamun illa min dareeAAin","translation":"For them there will be no food except from a poisonous, thorny plant","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5974,"surah":88,"ayah":7,"key":"88:7","numberInSurah":"٧","text":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","transliteration":"La yusminu wala yughnee min jooAAin","translation":"Which neither nourishes nor avails against hunger","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5975,"surah":88,"ayah":8,"key":"88:8","numberInSurah":"٨","text":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","transliteration":"Wujoohun yawmaithin naAAimatun","translation":"[Other] faces, that Day, will show pleasure","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5976,"surah":88,"ayah":9,"key":"88:9","numberInSurah":"٩","text":"لِّسَعۡيِهَا رَاضِيَةٞ","transliteration":"LisaAAyiha radiyatun","translation":"With their effort [they are] satisfied","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5977,"surah":88,"ayah":10,"key":"88:10","numberInSurah":"١٠","text":"فِي جَنَّةٍ عَالِيَةٖ","transliteration":"Fee jannatin AAaliyatin","translation":"In an elevated garden","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5978,"surah":88,"ayah":11,"key":"88:11","numberInSurah":"١١","text":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","transliteration":"La tasmaAAu feeha laghiyatan","translation":"Wherein they will hear no unsuitable speech","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5979,"surah":88,"ayah":12,"key":"88:12","numberInSurah":"١٢","text":"فِيهَا عَيۡنٞ جَارِيَةٞ","transliteration":"Feeha AAaynun jariyatun","translation":"Within it is a flowing spring","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5980,"surah":88,"ayah":13,"key":"88:13","numberInSurah":"١٣","text":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","transliteration":"Feeha sururun marfooAAatun","translation":"Within it are couches raised high","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5981,"surah":88,"ayah":14,"key":"88:14","numberInSurah":"١٤","text":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","transliteration":"Waakwabun mawdooAAatun","translation":"And cups put in place","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5982,"surah":88,"ayah":15,"key":"88:15","numberInSurah":"١٥","text":"وَنَمَارِقُ مَصۡفُوفَةٞ","transliteration":"Wanamariqu masfoofatun","translation":"And cushions lined up","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5983,"surah":88,"ayah":16,"key":"88:16","numberInSurah":"١٦","text":"وَزَرَابِيُّ مَبۡثُوثَةٌ","transliteration":"Wazarabiyyu mabthoothatun","translation":"And carpets spread around","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5984,"surah":88,"ayah":17,"key":"88:17","numberInSurah":"١٧","text":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","transliteration":"Afala yanthuroona ila alibili kayfa khuliqat","translation":"Then do they not look at the camels - how they are created","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5985,"surah":88,"ayah":18,"key":"88:18","numberInSurah":"١٨","text":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","transliteration":"Waila alssamai kayfa rufiAAat","translation":"And at the sky - how it is raised","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5986,"surah":88,"ayah":19,"key":"88:19","numberInSurah":"١٩","text":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","transliteration":"Waila aljibali kayfa nusibat","translation":"And at the mountains - how they are erected","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5987,"surah":88,"ayah":20,"key":"88:20","numberInSurah":"٢٠","text":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","transliteration":"Waila alardi kayfa sutihat","translation":"And at the earth - how it is spread out","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5988,"surah":88,"ayah":21,"key":"88:21","numberInSurah":"٢١","text":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","transliteration":"Fathakkir innama anta muthakkirun","translation":"So remind, [O Muhammad]; you are only a reminder","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5989,"surah":88,"ayah":22,"key":"88:22","numberInSurah":"٢٢","text":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","transliteration":"Lasta AAalayhim bimusaytirin","translation":"You are not over them a controller","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5990,"surah":88,"ayah":23,"key":"88:23","numberInSurah":"٢٣","text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","transliteration":"Illa man tawalla wakafara","translation":"However, he who turns away and disbelieves","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5991,"surah":88,"ayah":24,"key":"88:24","numberInSurah":"٢٤","text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","transliteration":"FayuAAaththibuhu Allahu alAAathaba alakbara","translation":"Then Allah will punish him with the greatest punishment","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5992,"surah":88,"ayah":25,"key":"88:25","numberInSurah":"٢٥","text":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","transliteration":"Inna ilayna iyabahum","translation":"Indeed, to Us is their return","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false},{"id":5993,"surah":88,"ayah":26,"key":"88:26","numberInSurah":"٢٦","text":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","transliteration":"Thumma inna AAalayna hisabahum","translation":"Then indeed, upon Us is their account","page":592,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":530,"sajdah":false}]}
