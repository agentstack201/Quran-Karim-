{"chapter":{"id":55,"name":"الرَّحمٰن","nameSimple":"الرحمن","transliteration":"Ar-Rahman","translation":"The Beneficent","revelation":"medinan","revelationOrder":97,"versesCount":78,"rukuCount":3,"firstVerseId":4902,"lastVerseId":4979,"startPage":531,"endPage":534,"startJuz":27,"endJuz":27,"hasBasmalah":true},"verses":[{"id":4902,"surah":55,"ayah":1,"key":"55:1","numberInSurah":"١","text":"ٱلرَّحۡمَٰنُ","transliteration":"Alrrahmanu","translation":"The Most Merciful","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4903,"surah":55,"ayah":2,"key":"55:2","numberInSurah":"٢","text":"عَلَّمَ ٱلۡقُرۡءَانَ","transliteration":"AAallama alqurana","translation":"Taught the Qur'an","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4904,"surah":55,"ayah":3,"key":"55:3","numberInSurah":"٣","text":"خَلَقَ ٱلۡإِنسَٰنَ","transliteration":"Khalaqa alinsana","translation":"Created man","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4905,"surah":55,"ayah":4,"key":"55:4","numberInSurah":"٤","text":"عَلَّمَهُ ٱلۡبَيَانَ","transliteration":"AAallamahu albayana","translation":"[And] taught him eloquence","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4906,"surah":55,"ayah":5,"key":"55:5","numberInSurah":"٥","text":"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ","transliteration":"Alshshamsu waalqamaru bihusbanin","translation":"The sun and the moon [move] by precise calculation","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4907,"surah":55,"ayah":6,"key":"55:6","numberInSurah":"٦","text":"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ","transliteration":"Waalnnajmu waalshshajaru yasjudani","translation":"And the stars and trees prostrate","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4908,"surah":55,"ayah":7,"key":"55:7","numberInSurah":"٧","text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ","transliteration":"Waalssamaa rafaAAaha wawadaAAa almeezana","translation":"And the heaven He raised and imposed the balance","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4909,"surah":55,"ayah":8,"key":"55:8","numberInSurah":"٨","text":"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ","transliteration":"Alla tatghaw fee almeezani","translation":"That you not transgress within the balance","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4910,"surah":55,"ayah":9,"key":"55:9","numberInSurah":"٩","text":"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ","transliteration":"Waaqeemoo alwazna bialqisti wala tukhsiroo almeezana","translation":"And establish weight in justice and do not make deficient the balance","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4911,"surah":55,"ayah":10,"key":"55:10","numberInSurah":"١٠","text":"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ","transliteration":"Waalarda wadaAAaha lilanami","translation":"And the earth He laid [out] for the creatures","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4912,"surah":55,"ayah":11,"key":"55:11","numberInSurah":"١١","text":"فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ","transliteration":"Feeha fakihatun waalnnakhlu thatu alakmami","translation":"Therein is fruit and palm trees having sheaths [of dates]","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4913,"surah":55,"ayah":12,"key":"55:12","numberInSurah":"١٢","text":"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ","transliteration":"Waalhabbu thoo alAAasfi waalrrayhani","translation":"And grain having husks and scented plants","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4914,"surah":55,"ayah":13,"key":"55:13","numberInSurah":"١٣","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4915,"surah":55,"ayah":14,"key":"55:14","numberInSurah":"١٤","text":"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ","transliteration":"Khalaqa alinsana min salsalin kaalfakhkhari","translation":"He created man from clay like [that of] pottery","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4916,"surah":55,"ayah":15,"key":"55:15","numberInSurah":"١٥","text":"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ","transliteration":"Wakhalaqa aljanna min marijin min narin","translation":"And He created the jinn from a smokeless flame of fire","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4917,"surah":55,"ayah":16,"key":"55:16","numberInSurah":"١٦","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":531,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4918,"surah":55,"ayah":17,"key":"55:17","numberInSurah":"١٧","text":"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ","transliteration":"Rabbu almashriqayni warabbu almaghribayni","translation":"[He is] Lord of the two sunrises and Lord of the two sunsets","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4919,"surah":55,"ayah":18,"key":"55:18","numberInSurah":"١٨","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4920,"surah":55,"ayah":19,"key":"55:19","numberInSurah":"١٩","text":"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ","transliteration":"Maraja albahrayni yaltaqiyani","translation":"He released the two seas, meeting [side by side]","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4921,"surah":55,"ayah":20,"key":"55:20","numberInSurah":"٢٠","text":"بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ","transliteration":"Baynahuma barzakhun la yabghiyani","translation":"Between them is a barrier [so] neither of them transgresses","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4922,"surah":55,"ayah":21,"key":"55:21","numberInSurah":"٢١","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4923,"surah":55,"ayah":22,"key":"55:22","numberInSurah":"٢٢","text":"يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ","transliteration":"Yakhruju minhuma alluluo waalmarjanu","translation":"From both of them emerge pearl and coral","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4924,"surah":55,"ayah":23,"key":"55:23","numberInSurah":"٢٣","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4925,"surah":55,"ayah":24,"key":"55:24","numberInSurah":"٢٤","text":"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ","transliteration":"Walahu aljawari almunshaatu fee albahri kaalaAAlami","translation":"And to Him belong the ships [with sails] elevated in the sea like mountains","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4926,"surah":55,"ayah":25,"key":"55:25","numberInSurah":"٢٥","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":466,"sajdah":false},{"id":4927,"surah":55,"ayah":26,"key":"55:26","numberInSurah":"٢٦","text":"كُلُّ مَنۡ عَلَيۡهَا فَانٖ","transliteration":"Kullu man AAalayha fanin","translation":"Everyone upon the earth will perish","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4928,"surah":55,"ayah":27,"key":"55:27","numberInSurah":"٢٧","text":"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ","transliteration":"Wayabqa wajhu rabbika thoo aljalali waalikrami","translation":"And there will remain the Face of your Lord, Owner of Majesty and Honor","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4929,"surah":55,"ayah":28,"key":"55:28","numberInSurah":"٢٨","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4930,"surah":55,"ayah":29,"key":"55:29","numberInSurah":"٢٩","text":"يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ","transliteration":"Yasaluhu man fee alssamawati waalardi kulla yawmin huwa fee shanin","translation":"Whoever is within the heavens and earth asks Him; every day He is bringing about a matter","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4931,"surah":55,"ayah":30,"key":"55:30","numberInSurah":"٣٠","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4932,"surah":55,"ayah":31,"key":"55:31","numberInSurah":"٣١","text":"سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ","transliteration":"Sanafrughu lakum ayyuha alththaqalani","translation":"We will attend to you, O prominent beings","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4933,"surah":55,"ayah":32,"key":"55:32","numberInSurah":"٣٢","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4934,"surah":55,"ayah":33,"key":"55:33","numberInSurah":"٣٣","text":"يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ","transliteration":"Ya maAAshara aljinni waalinsi ini istataAAtum an tanfuthoo min aqtari alssamawati waalardi faonfuthoo la tanfuthoona illa bisultanin","translation":"O company of jinn and mankind, if you are able to pass beyond the regions of the heavens and the earth, then pass. You will not pass except by authority [from Allah]","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4935,"surah":55,"ayah":34,"key":"55:34","numberInSurah":"٣٤","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4936,"surah":55,"ayah":35,"key":"55:35","numberInSurah":"٣٥","text":"يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ","transliteration":"Yursalu AAalaykuma shuwathun min narin wanuhasun fala tantasirani","translation":"There will be sent upon you a flame of fire and smoke, and you will not defend yourselves","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4937,"surah":55,"ayah":36,"key":"55:36","numberInSurah":"٣٦","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4938,"surah":55,"ayah":37,"key":"55:37","numberInSurah":"٣٧","text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ","transliteration":"Faitha inshaqqati alssamao fakanat wardatan kaalddihani","translation":"And when the heaven is split open and becomes rose-colored like oil","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4939,"surah":55,"ayah":38,"key":"55:38","numberInSurah":"٣٨","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4940,"surah":55,"ayah":39,"key":"55:39","numberInSurah":"٣٩","text":"فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ","transliteration":"Fayawmaithin la yusalu AAan thanbihi insun wala jannun","translation":"Then on that Day none will be asked about his sin among men or jinn","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4941,"surah":55,"ayah":40,"key":"55:40","numberInSurah":"٤٠","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":532,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4942,"surah":55,"ayah":41,"key":"55:41","numberInSurah":"٤١","text":"يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ","transliteration":"YuAArafu almujrimoona biseemahum fayukhathu bialnnawasee waalaqdami","translation":"The criminals will be known by their marks, and they will be seized by the forelocks and the feet","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4943,"surah":55,"ayah":42,"key":"55:42","numberInSurah":"٤٢","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4944,"surah":55,"ayah":43,"key":"55:43","numberInSurah":"٤٣","text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ","transliteration":"Hathihi jahannamu allatee yukaththibu biha almujrimoona","translation":"This is Hell, which the criminals deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4945,"surah":55,"ayah":44,"key":"55:44","numberInSurah":"٤٤","text":"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ","transliteration":"Yatoofoona baynaha wabayna hameemin anin","translation":"They will go around between it and scalding water, heated [to the utmost degree]","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4946,"surah":55,"ayah":45,"key":"55:45","numberInSurah":"٤٥","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":467,"sajdah":false},{"id":4947,"surah":55,"ayah":46,"key":"55:46","numberInSurah":"٤٦","text":"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","transliteration":"Waliman khafa maqama rabbihi jannatani","translation":"But for he who has feared the position of his Lord are two gardens","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4948,"surah":55,"ayah":47,"key":"55:47","numberInSurah":"٤٧","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4949,"surah":55,"ayah":48,"key":"55:48","numberInSurah":"٤٨","text":"ذَوَاتَآ أَفۡنَانٖ","transliteration":"Thawata afnanin","translation":"Having [spreading] branches","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4950,"surah":55,"ayah":49,"key":"55:49","numberInSurah":"٤٩","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4951,"surah":55,"ayah":50,"key":"55:50","numberInSurah":"٥٠","text":"فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ","transliteration":"Feehima AAaynani tajriyani","translation":"In both of them are two springs, flowing","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4952,"surah":55,"ayah":51,"key":"55:51","numberInSurah":"٥١","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4953,"surah":55,"ayah":52,"key":"55:52","numberInSurah":"٥٢","text":"فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ","transliteration":"Feehima min kulli fakihatin zawjani","translation":"In both of them are of every fruit, two kinds","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4954,"surah":55,"ayah":53,"key":"55:53","numberInSurah":"٥٣","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4955,"surah":55,"ayah":54,"key":"55:54","numberInSurah":"٥٤","text":"مُتَّكِـِٔينَ عَلَىٰ فُرُشِۭ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى ٱلۡجَنَّتَيۡنِ دَانٖ","transliteration":"Muttakieena AAala furushin batainuha min istabraqin wajana aljannatayni danin","translation":"[They are] reclining on beds whose linings are of silk brocade, and the fruit of the two gardens is hanging low","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4956,"surah":55,"ayah":55,"key":"55:55","numberInSurah":"٥٥","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4957,"surah":55,"ayah":56,"key":"55:56","numberInSurah":"٥٦","text":"فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ","transliteration":"Feehinna qasiratu alttarfi lam yatmithhunna insun qablahum wala jannun","translation":"In them are women limiting [their] glances, untouched before them by man or jinni","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4958,"surah":55,"ayah":57,"key":"55:57","numberInSurah":"٥٧","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4959,"surah":55,"ayah":58,"key":"55:58","numberInSurah":"٥٨","text":"كَأَنَّهُنَّ ٱلۡيَاقُوتُ وَٱلۡمَرۡجَانُ","transliteration":"Kaannahunna alyaqootu waalmarjanu","translation":"As if they were rubies and coral","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4960,"surah":55,"ayah":59,"key":"55:59","numberInSurah":"٥٩","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4961,"surah":55,"ayah":60,"key":"55:60","numberInSurah":"٦٠","text":"هَلۡ جَزَآءُ ٱلۡإِحۡسَٰنِ إِلَّا ٱلۡإِحۡسَٰنُ","transliteration":"Hal jazao alihsani illa alihsanu","translation":"Is the reward for good [anything] but good","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4962,"surah":55,"ayah":61,"key":"55:61","numberInSurah":"٦١","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4963,"surah":55,"ayah":62,"key":"55:62","numberInSurah":"٦٢","text":"وَمِن دُونِهِمَا جَنَّتَانِ","transliteration":"Wamin doonihima jannatani","translation":"And below them both [in excellence] are two [other] gardens","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4964,"surah":55,"ayah":63,"key":"55:63","numberInSurah":"٦٣","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4965,"surah":55,"ayah":64,"key":"55:64","numberInSurah":"٦٤","text":"مُدۡهَآمَّتَانِ","transliteration":"Mudhammatani","translation":"Dark green [in color]","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4966,"surah":55,"ayah":65,"key":"55:65","numberInSurah":"٦٥","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4967,"surah":55,"ayah":66,"key":"55:66","numberInSurah":"٦٦","text":"فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ","transliteration":"Feehima AAaynani naddakhatani","translation":"In both of them are two springs, spouting","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4968,"surah":55,"ayah":67,"key":"55:67","numberInSurah":"٦٧","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":533,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4969,"surah":55,"ayah":68,"key":"55:68","numberInSurah":"٦٨","text":"فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ","transliteration":"Feehima fakihatun wanakhlun warummanun","translation":"In both of them are fruit and palm trees and pomegranates","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4970,"surah":55,"ayah":69,"key":"55:69","numberInSurah":"٦٩","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4971,"surah":55,"ayah":70,"key":"55:70","numberInSurah":"٧٠","text":"فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ","transliteration":"Feehinna khayratun hisanun","translation":"In them are good and beautiful women","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4972,"surah":55,"ayah":71,"key":"55:71","numberInSurah":"٧١","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4973,"surah":55,"ayah":72,"key":"55:72","numberInSurah":"٧٢","text":"حُورٞ مَّقۡصُورَٰتٞ فِي ٱلۡخِيَامِ","transliteration":"Hoorun maqsooratun fee alkhiyami","translation":"Fair ones reserved in pavilions","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4974,"surah":55,"ayah":73,"key":"55:73","numberInSurah":"٧٣","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4975,"surah":55,"ayah":74,"key":"55:74","numberInSurah":"٧٤","text":"لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ","transliteration":"Lam yatmithhunna insun qablahum wala jannun","translation":"Untouched before them by man or jinni","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4976,"surah":55,"ayah":75,"key":"55:75","numberInSurah":"٧٥","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4977,"surah":55,"ayah":76,"key":"55:76","numberInSurah":"٧٦","text":"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ","transliteration":"Muttakieena AAala rafrafin khudrin waAAabqariyyin hisanin","translation":"Reclining on green cushions and beautiful fine carpets","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4978,"surah":55,"ayah":77,"key":"55:77","numberInSurah":"٧٧","text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","transliteration":"Fabiayyi alai rabbikuma tukaththibani","translation":"So which of the favors of your Lord would you deny","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false},{"id":4979,"surah":55,"ayah":78,"key":"55:78","numberInSurah":"٧٨","text":"تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ","transliteration":"Tabaraka ismu rabbika thee aljalali waalikrami","translation":"Blessed is the name of your Lord, Owner of Majesty and Honor","page":534,"juz":27,"hizb":54,"rubAlHizb":213,"ruku":468,"sajdah":false}]}
