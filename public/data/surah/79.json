{"chapter":{"id":79,"name":"النَّازعَات","nameSimple":"النازعات","transliteration":"An-Nazi'at","translation":"Those who drag forth","revelation":"meccan","revelationOrder":81,"versesCount":46,"rukuCount":2,"firstVerseId":5713,"lastVerseId":5758,"startPage":583,"endPage":584,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5713,"surah":79,"ayah":1,"key":"79:1","numberInSurah":"١","text":"وَٱلنَّـٰزِعَٰتِ غَرۡقٗا","transliteration":"WaalnnaziAAati gharqan","translation":"By those [angels] who extract with violence","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5714,"surah":79,"ayah":2,"key":"79:2","numberInSurah":"٢","text":"وَٱلنَّـٰشِطَٰتِ نَشۡطٗا","transliteration":"Waalnnashitati nashtan","translation":"And [by] those who remove with ease","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5715,"surah":79,"ayah":3,"key":"79:3","numberInSurah":"٣","text":"وَٱلسَّـٰبِحَٰتِ سَبۡحٗا","transliteration":"Waalssabihati sabhan","translation":"And [by] those who glide [as if] swimming","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5716,"surah":79,"ayah":4,"key":"79:4","numberInSurah":"٤","text":"فَٱلسَّـٰبِقَٰتِ سَبۡقٗا","transliteration":"Faalssabiqati sabqan","translation":"And those who race each other in a race","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5717,"surah":79,"ayah":5,"key":"79:5","numberInSurah":"٥","text":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا","transliteration":"Faalmudabbirati amran","translation":"And those who arrange [each] matter","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5718,"surah":79,"ayah":6,"key":"79:6","numberInSurah":"٦","text":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","transliteration":"Yawma tarjufu alrrajifatu","translation":"On the Day the blast [of the Horn] will convulse [creation]","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5719,"surah":79,"ayah":7,"key":"79:7","numberInSurah":"٧","text":"تَتۡبَعُهَا ٱلرَّادِفَةُ","transliteration":"TatbaAAuha alrradifatu","translation":"There will follow it the subsequent [one]","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5720,"surah":79,"ayah":8,"key":"79:8","numberInSurah":"٨","text":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ","transliteration":"Quloobun yawmaithin wajifatun","translation":"Hearts, that Day, will tremble","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5721,"surah":79,"ayah":9,"key":"79:9","numberInSurah":"٩","text":"أَبۡصَٰرُهَا خَٰشِعَةٞ","transliteration":"Absaruha khashiAAatun","translation":"Their eyes humbled","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5722,"surah":79,"ayah":10,"key":"79:10","numberInSurah":"١٠","text":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ","transliteration":"Yaqooloona ainna lamardoodoona fee alhafirati","translation":"They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5723,"surah":79,"ayah":11,"key":"79:11","numberInSurah":"١١","text":"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ","transliteration":"Aitha kunna AAithaman nakhiratan","translation":"Even if we should be decayed bones","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5724,"surah":79,"ayah":12,"key":"79:12","numberInSurah":"١٢","text":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ","transliteration":"Qaloo tilka ithan karratun khasiratun","translation":"They say, \"That, then, would be a losing return","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5725,"surah":79,"ayah":13,"key":"79:13","numberInSurah":"١٣","text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ","transliteration":"Fainnama hiya zajratun wahidatun","translation":"Indeed, it will be but one shout","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5726,"surah":79,"ayah":14,"key":"79:14","numberInSurah":"١٤","text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","transliteration":"Faitha hum bialssahirati","translation":"And suddenly they will be [alert] upon the earth's surface","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5727,"surah":79,"ayah":15,"key":"79:15","numberInSurah":"١٥","text":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","transliteration":"Hal ataka hadeethu moosa","translation":"Has there reached you the story of Moses","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5728,"surah":79,"ayah":16,"key":"79:16","numberInSurah":"١٦","text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى","transliteration":"Ith nadahu rabbuhu bialwadi almuqaddasi tuwan","translation":"When his Lord called to him in the sacred valley of Tuwa","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5729,"surah":79,"ayah":17,"key":"79:17","numberInSurah":"١٧","text":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","transliteration":"Ithhab ila firAAawna innahu tagha","translation":"Go to Pharaoh. Indeed, he has transgressed","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5730,"surah":79,"ayah":18,"key":"79:18","numberInSurah":"١٨","text":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","transliteration":"Faqul hal laka ila an tazakka","translation":"And say to him, 'Would you [be willing to] purify yourself","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5731,"surah":79,"ayah":19,"key":"79:19","numberInSurah":"١٩","text":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ","transliteration":"Waahdiyaka ila rabbika fatakhsha","translation":"And let me guide you to your Lord so you would fear [Him]","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5732,"surah":79,"ayah":20,"key":"79:20","numberInSurah":"٢٠","text":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","transliteration":"Faarahu alayata alkubra","translation":"And he showed him the greatest sign","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5733,"surah":79,"ayah":21,"key":"79:21","numberInSurah":"٢١","text":"فَكَذَّبَ وَعَصَىٰ","transliteration":"Fakaththaba waAAasa","translation":"But Pharaoh denied and disobeyed","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5734,"surah":79,"ayah":22,"key":"79:22","numberInSurah":"٢٢","text":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ","transliteration":"Thumma adbara yasAAa","translation":"Then he turned his back, striving","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5735,"surah":79,"ayah":23,"key":"79:23","numberInSurah":"٢٣","text":"فَحَشَرَ فَنَادَىٰ","transliteration":"Fahashara fanada","translation":"And he gathered [his people] and called out","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5736,"surah":79,"ayah":24,"key":"79:24","numberInSurah":"٢٤","text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ","transliteration":"Faqala ana rabbukumu alaAAla","translation":"And said, \"I am your most exalted lord","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5737,"surah":79,"ayah":25,"key":"79:25","numberInSurah":"٢٥","text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ","transliteration":"Faakhathahu Allahu nakala alakhirati waaloola","translation":"So Allah seized him in exemplary punishment for the last and the first [transgression]","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5738,"surah":79,"ayah":26,"key":"79:26","numberInSurah":"٢٦","text":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ","transliteration":"Inna fee thalika laAAibratan liman yakhsha","translation":"Indeed in that is a warning for whoever would fear [Allah]","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":520,"sajdah":false},{"id":5739,"surah":79,"ayah":27,"key":"79:27","numberInSurah":"٢٧","text":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا","transliteration":"Aantum ashaddu khalqan ami alssamao banaha","translation":"Are you a more difficult creation or is the heaven? Allah constructed it","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5740,"surah":79,"ayah":28,"key":"79:28","numberInSurah":"٢٨","text":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا","transliteration":"RafaAAa samkaha fasawwaha","translation":"He raised its ceiling and proportioned it","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5741,"surah":79,"ayah":29,"key":"79:29","numberInSurah":"٢٩","text":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا","transliteration":"Waaghtasha laylaha waakhraja duhaha","translation":"And He darkened its night and extracted its brightness","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5742,"surah":79,"ayah":30,"key":"79:30","numberInSurah":"٣٠","text":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ","transliteration":"Waalarda baAAda thalika dahaha","translation":"And after that He spread the earth","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5743,"surah":79,"ayah":31,"key":"79:31","numberInSurah":"٣١","text":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا","transliteration":"Akhraja minha maaha wamarAAaha","translation":"He extracted from it its water and its pasture","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5744,"surah":79,"ayah":32,"key":"79:32","numberInSurah":"٣٢","text":"وَٱلۡجِبَالَ أَرۡسَىٰهَا","transliteration":"Waaljibala arsaha","translation":"And the mountains He set firmly","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5745,"surah":79,"ayah":33,"key":"79:33","numberInSurah":"٣٣","text":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","transliteration":"MataAAan lakum walianAAamikum","translation":"As provision for you and your grazing livestock","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5746,"surah":79,"ayah":34,"key":"79:34","numberInSurah":"٣٤","text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","transliteration":"Faitha jaati alttammatu alkubra","translation":"But when there comes the greatest Overwhelming Calamity","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5747,"surah":79,"ayah":35,"key":"79:35","numberInSurah":"٣٥","text":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","transliteration":"Yawma yatathakkaru alinsanu ma saAAa","translation":"The Day when man will remember that for which he strove","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5748,"surah":79,"ayah":36,"key":"79:36","numberInSurah":"٣٦","text":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ","transliteration":"Waburrizati aljaheemu liman yara","translation":"And Hellfire will be exposed for [all] those who see","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5749,"surah":79,"ayah":37,"key":"79:37","numberInSurah":"٣٧","text":"فَأَمَّا مَن طَغَىٰ","transliteration":"Faamma man tagha","translation":"So as for he who transgressed","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5750,"surah":79,"ayah":38,"key":"79:38","numberInSurah":"٣٨","text":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","transliteration":"Waathara alhayata alddunya","translation":"And preferred the life of the world","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5751,"surah":79,"ayah":39,"key":"79:39","numberInSurah":"٣٩","text":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ","transliteration":"Fainna aljaheema hiya almawa","translation":"Then indeed, Hellfire will be [his] refuge","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5752,"surah":79,"ayah":40,"key":"79:40","numberInSurah":"٤٠","text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ","transliteration":"Waama man khafa maqama rabbihi wanaha alnnafsa AAani alhawa","translation":"But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5753,"surah":79,"ayah":41,"key":"79:41","numberInSurah":"٤١","text":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ","transliteration":"Fainna aljannata hiya almawa","translation":"Then indeed, Paradise will be [his] refuge","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5754,"surah":79,"ayah":42,"key":"79:42","numberInSurah":"٤٢","text":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا","transliteration":"Yasaloonaka AAani alssaAAati ayyana mursaha","translation":"They ask you, [O Muhammad], about the Hour: when is its arrival","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5755,"surah":79,"ayah":43,"key":"79:43","numberInSurah":"٤٣","text":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","transliteration":"Feema anta min thikraha","translation":"In what [position] are you that you should mention it","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5756,"surah":79,"ayah":44,"key":"79:44","numberInSurah":"٤٤","text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","transliteration":"Ila rabbika muntahaha","translation":"To your Lord is its finality","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5757,"surah":79,"ayah":45,"key":"79:45","numberInSurah":"٤٥","text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا","transliteration":"Innama anta munthiru man yakhshaha","translation":"You are only a warner for those who fear it","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false},{"id":5758,"surah":79,"ayah":46,"key":"79:46","numberInSurah":"٤٦","text":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا","transliteration":"Kaannahum yawma yarawnaha lam yalbathoo illa AAashiyyatan aw duhaha","translation":"It will be, on the Day they see it, as though they had not remained [in the world] except for an afternoon or a morning thereof","page":584,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":521,"sajdah":false}]}
