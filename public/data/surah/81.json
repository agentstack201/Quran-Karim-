{"chapter":{"id":81,"name":"التَّكوير","nameSimple":"التكوير","transliteration":"At-Takwir","translation":"The Overthrowing","revelation":"meccan","revelationOrder":7,"versesCount":29,"rukuCount":1,"firstVerseId":5801,"lastVerseId":5829,"startPage":586,"endPage":586,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5801,"surah":81,"ayah":1,"key":"81:1","numberInSurah":"١","text":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","transliteration":"Itha alshshamsu kuwwirat","translation":"When the sun is wrapped up [in darkness]","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5802,"surah":81,"ayah":2,"key":"81:2","numberInSurah":"٢","text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","transliteration":"Waitha alnnujoomu inkadarat","translation":"And when the stars fall, dispersing","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5803,"surah":81,"ayah":3,"key":"81:3","numberInSurah":"٣","text":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","transliteration":"Waitha aljibalu suyyirat","translation":"And when the mountains are removed","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5804,"surah":81,"ayah":4,"key":"81:4","numberInSurah":"٤","text":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","transliteration":"Waitha alAAisharu AAuttilat","translation":"And when full-term she-camels are neglected","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5805,"surah":81,"ayah":5,"key":"81:5","numberInSurah":"٥","text":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","transliteration":"Waitha alwuhooshu hushirat","translation":"And when the wild beasts are gathered","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5806,"surah":81,"ayah":6,"key":"81:6","numberInSurah":"٦","text":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ","transliteration":"Waitha albiharu sujjirat","translation":"And when the seas are filled with flame","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5807,"surah":81,"ayah":7,"key":"81:7","numberInSurah":"٧","text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","transliteration":"Waitha alnnufoosu zuwwijat","translation":"And when the souls are paired","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5808,"surah":81,"ayah":8,"key":"81:8","numberInSurah":"٨","text":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","transliteration":"Waitha almawoodatu suilat","translation":"And when the girl [who was] buried alive is asked","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5809,"surah":81,"ayah":9,"key":"81:9","numberInSurah":"٩","text":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ","transliteration":"Biayyi thanbin qutilat","translation":"For what sin she was killed","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5810,"surah":81,"ayah":10,"key":"81:10","numberInSurah":"١٠","text":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ","transliteration":"Waitha alssuhufu nushirat","translation":"And when the pages are made public","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5811,"surah":81,"ayah":11,"key":"81:11","numberInSurah":"١١","text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","transliteration":"Waitha alssamao kushitat","translation":"And when the sky is stripped away","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5812,"surah":81,"ayah":12,"key":"81:12","numberInSurah":"١٢","text":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ","transliteration":"Waitha aljaheemu suAAAAirat","translation":"And when Hellfire is set ablaze","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5813,"surah":81,"ayah":13,"key":"81:13","numberInSurah":"١٣","text":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","transliteration":"Waitha aljannatu ozlifat","translation":"And when Paradise is brought near","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5814,"surah":81,"ayah":14,"key":"81:14","numberInSurah":"١٤","text":"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ","transliteration":"AAalimat nafsun ma ahdarat","translation":"A soul will [then] know what it has brought [with it]","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5815,"surah":81,"ayah":15,"key":"81:15","numberInSurah":"١٥","text":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ","transliteration":"Fala oqsimu bialkhunnasi","translation":"So I swear by the retreating stars","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5816,"surah":81,"ayah":16,"key":"81:16","numberInSurah":"١٦","text":"ٱلۡجَوَارِ ٱلۡكُنَّسِ","transliteration":"Aljawari alkunnasi","translation":"Those that run [their courses] and disappear","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5817,"surah":81,"ayah":17,"key":"81:17","numberInSurah":"١٧","text":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","transliteration":"Waallayli itha AAasAAasa","translation":"And by the night as it closes in","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5818,"surah":81,"ayah":18,"key":"81:18","numberInSurah":"١٨","text":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","transliteration":"Waalssubhi itha tanaffasa","translation":"And by the dawn when it breathes","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5819,"surah":81,"ayah":19,"key":"81:19","numberInSurah":"١٩","text":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","transliteration":"Innahu laqawlu rasoolin kareemin","translation":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5820,"surah":81,"ayah":20,"key":"81:20","numberInSurah":"٢٠","text":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ","transliteration":"Thee quwwatin AAinda thee alAAarshi makeenin","translation":"[Who is] possessed of power and with the Owner of the Throne, secure [in position]","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5821,"surah":81,"ayah":21,"key":"81:21","numberInSurah":"٢١","text":"مُّطَاعٖ ثَمَّ أَمِينٖ","transliteration":"MutaAAin thamma ameenin","translation":"Obeyed there [in the heavens] and trustworthy","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5822,"surah":81,"ayah":22,"key":"81:22","numberInSurah":"٢٢","text":"وَمَا صَاحِبُكُم بِمَجۡنُونٖ","transliteration":"Wama sahibukum bimajnoonin","translation":"And your companion is not [at all] mad","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5823,"surah":81,"ayah":23,"key":"81:23","numberInSurah":"٢٣","text":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ","transliteration":"Walaqad raahu bialofuqi almubeeni","translation":"And he has already seen Gabriel in the clear horizon","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5824,"surah":81,"ayah":24,"key":"81:24","numberInSurah":"٢٤","text":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ","transliteration":"Wama huwa AAala alghaybi bidaneenin","translation":"And Muhammad is not a withholder of [knowledge of] the unseen","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5825,"surah":81,"ayah":25,"key":"81:25","numberInSurah":"٢٥","text":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ","transliteration":"Wama huwa biqawli shaytanin rajeemin","translation":"And the Qur'an is not the word of a devil, expelled [from the heavens]","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5826,"surah":81,"ayah":26,"key":"81:26","numberInSurah":"٢٦","text":"فَأَيۡنَ تَذۡهَبُونَ","transliteration":"Faayna tathhaboona","translation":"So where are you going","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5827,"surah":81,"ayah":27,"key":"81:27","numberInSurah":"٢٧","text":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","transliteration":"In huwa illa thikrun lilAAalameena","translation":"It is not except a reminder to the worlds","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5828,"surah":81,"ayah":28,"key":"81:28","numberInSurah":"٢٨","text":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","transliteration":"Liman shaa minkum an yastaqeema","translation":"For whoever wills among you to take a right course","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false},{"id":5829,"surah":81,"ayah":29,"key":"81:29","numberInSurah":"٢٩","text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","transliteration":"Wama tashaoona illa an yashaa Allahu rabbu alAAalameena","translation":"And you do not will except that Allah wills - Lord of the worlds","page":586,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":523,"sajdah":false}]}
