{"chapter":{"id":93,"name":"الضُّحى","nameSimple":"الضحى","transliteration":"Ad-Duhaa","translation":"The Morning Hours","revelation":"meccan","revelationOrder":11,"versesCount":11,"rukuCount":1,"firstVerseId":6080,"lastVerseId":6090,"startPage":596,"endPage":596,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6080,"surah":93,"ayah":1,"key":"93:1","numberInSurah":"١","text":"وَٱلضُّحَىٰ","transliteration":"Waaldduha","translation":"By the morning brightness","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6081,"surah":93,"ayah":2,"key":"93:2","numberInSurah":"٢","text":"وَٱلَّيۡلِ إِذَا سَجَىٰ","transliteration":"Waallayli itha saja","translation":"And [by] the night when it covers with darkness","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6082,"surah":93,"ayah":3,"key":"93:3","numberInSurah":"٣","text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","transliteration":"Ma waddaAAaka rabbuka wama qala","translation":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you]","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6083,"surah":93,"ayah":4,"key":"93:4","numberInSurah":"٤","text":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ","transliteration":"Walalakhiratu khayrun laka mina aloola","translation":"And the Hereafter is better for you than the first [life]","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6084,"surah":93,"ayah":5,"key":"93:5","numberInSurah":"٥","text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","transliteration":"Walasawfa yuAAteeka rabbuka fatarda","translation":"And your Lord is going to give you, and you will be satisfied","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6085,"surah":93,"ayah":6,"key":"93:6","numberInSurah":"٦","text":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ","transliteration":"Alam yajidka yateeman faawa","translation":"Did He not find you an orphan and give [you] refuge","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6086,"surah":93,"ayah":7,"key":"93:7","numberInSurah":"٧","text":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ","transliteration":"Wawajadaka dallan fahada","translation":"And He found you lost and guided [you]","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6087,"surah":93,"ayah":8,"key":"93:8","numberInSurah":"٨","text":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ","transliteration":"Wawajadaka AAailan faaghna","translation":"And He found you poor and made [you] self-sufficient","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6088,"surah":93,"ayah":9,"key":"93:9","numberInSurah":"٩","text":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","transliteration":"Faamma alyateema fala taqhar","translation":"So as for the orphan, do not oppress [him]","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6089,"surah":93,"ayah":10,"key":"93:10","numberInSurah":"١٠","text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","transliteration":"Waamma alssaila fala tanhar","translation":"And as for the petitioner, do not repel [him]","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false},{"id":6090,"surah":93,"ayah":11,"key":"93:11","numberInSurah":"١١","text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","transliteration":"Waamma biniAAmati rabbika fahaddith","translation":"But as for the favor of your Lord, report [it]","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":535,"sajdah":false}]}
