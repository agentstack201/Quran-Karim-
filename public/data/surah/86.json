{"chapter":{"id":86,"name":"الطَّارق","nameSimple":"الطارق","transliteration":"At-Tariq","translation":"The Nightcommer","revelation":"meccan","revelationOrder":36,"versesCount":17,"rukuCount":1,"firstVerseId":5932,"lastVerseId":5948,"startPage":591,"endPage":591,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5932,"surah":86,"ayah":1,"key":"86:1","numberInSurah":"١","text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","transliteration":"Waalssamai waalttariqi","translation":"By the sky and the night comer","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5933,"surah":86,"ayah":2,"key":"86:2","numberInSurah":"٢","text":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","transliteration":"Wama adraka ma alttariqu","translation":"And what can make you know what is the night comer","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5934,"surah":86,"ayah":3,"key":"86:3","numberInSurah":"٣","text":"ٱلنَّجۡمُ ٱلثَّاقِبُ","transliteration":"Alnnajmu alththaqibu","translation":"It is the piercing star","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5935,"surah":86,"ayah":4,"key":"86:4","numberInSurah":"٤","text":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","transliteration":"In kullu nafsin lamma AAalayha hafithun","translation":"There is no soul but that it has over it a protector","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5936,"surah":86,"ayah":5,"key":"86:5","numberInSurah":"٥","text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","transliteration":"Falyanthuri alinsanu mimma khuliqa","translation":"So let man observe from what he was created","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5937,"surah":86,"ayah":6,"key":"86:6","numberInSurah":"٦","text":"خُلِقَ مِن مَّآءٖ دَافِقٖ","transliteration":"Khuliqa min main dafiqin","translation":"He was created from a fluid, ejected","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5938,"surah":86,"ayah":7,"key":"86:7","numberInSurah":"٧","text":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","transliteration":"Yakhruju min bayni alssulbi waalttaraibi","translation":"Emerging from between the backbone and the ribs","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5939,"surah":86,"ayah":8,"key":"86:8","numberInSurah":"٨","text":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","transliteration":"Innahu AAala rajAAihi laqadirun","translation":"Indeed, Allah, to return him [to life], is Able","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5940,"surah":86,"ayah":9,"key":"86:9","numberInSurah":"٩","text":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","transliteration":"Yawma tubla alssarairu","translation":"The Day when secrets will be put on trial","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5941,"surah":86,"ayah":10,"key":"86:10","numberInSurah":"١٠","text":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","transliteration":"Fama lahu min quwwatin wala nasirin","translation":"Then man will have no power or any helper","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5942,"surah":86,"ayah":11,"key":"86:11","numberInSurah":"١١","text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","transliteration":"Waalssamai thati alrrajAAi","translation":"By the sky which returns [rain]","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5943,"surah":86,"ayah":12,"key":"86:12","numberInSurah":"١٢","text":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","transliteration":"Waalardi thati alssadAAi","translation":"And [by] the earth which cracks open","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5944,"surah":86,"ayah":13,"key":"86:13","numberInSurah":"١٣","text":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","transliteration":"Innahu laqawlun faslun","translation":"Indeed, the Qur'an is a decisive statement","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5945,"surah":86,"ayah":14,"key":"86:14","numberInSurah":"١٤","text":"وَمَا هُوَ بِٱلۡهَزۡلِ","transliteration":"Wama huwa bialhazli","translation":"And it is not amusement","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5946,"surah":86,"ayah":15,"key":"86:15","numberInSurah":"١٥","text":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","transliteration":"Innahum yakeedoona kaydan","translation":"Indeed, they are planning a plan","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5947,"surah":86,"ayah":16,"key":"86:16","numberInSurah":"١٦","text":"وَأَكِيدُ كَيۡدٗا","transliteration":"Waakeedu kaydan","translation":"But I am planning a plan","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false},{"id":5948,"surah":86,"ayah":17,"key":"86:17","numberInSurah":"١٧","text":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","transliteration":"Famahhili alkafireena amhilhum ruwaydan","translation":"So allow time for the disbelievers. Leave them awhile","page":591,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":528,"sajdah":false}]}
