{"chapter":{"id":113,"name":"الفَلَق","nameSimple":"الفلق","transliteration":"Al-Falaq","translation":"The Daybreak","revelation":"meccan","revelationOrder":20,"versesCount":5,"rukuCount":1,"firstVerseId":6226,"lastVerseId":6230,"startPage":604,"endPage":604,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6226,"surah":113,"ayah":1,"key":"113:1","numberInSurah":"١","text":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","transliteration":"Qul aAAoothu birabbi alfalaqi","translation":"Say, \"I seek refuge in the Lord of daybreak","page":604,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":555,"sajdah":false},{"id":6227,"surah":113,"ayah":2,"key":"113:2","numberInSurah":"٢","text":"مِن شَرِّ مَا خَلَقَ","transliteration":"Min sharri ma khalaqa","translation":"From the evil of that which He created","page":604,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":555,"sajdah":false},{"id":6228,"surah":113,"ayah":3,"key":"113:3","numberInSurah":"٣","text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","transliteration":"Wamin sharri ghasiqin itha waqaba","translation":"And from the evil of darkness when it settles","page":604,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":555,"sajdah":false},{"id":6229,"surah":113,"ayah":4,"key":"113:4","numberInSurah":"٤","text":"وَمِن شَرِّ ٱلنَّفَّـٰثَٰتِ فِي ٱلۡعُقَدِ","transliteration":"Wamin sharri alnnaffathati fee alAAuqadi","translation":"And from the evil of the blowers in knots","page":604,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":555,"sajdah":false},{"id":6230,"surah":113,"ayah":5,"key":"113:5","numberInSurah":"٥","text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","transliteration":"Wamin sharri hasidin itha hasada","translation":"And from the evil of an envier when he envies","page":604,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":555,"sajdah":false}]}
