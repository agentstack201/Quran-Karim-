{"chapter":{"id":101,"name":"القَارعَة","nameSimple":"القارعة","transliteration":"Al-Qari'ah","translation":"The Calamity","revelation":"meccan","revelationOrder":30,"versesCount":11,"rukuCount":1,"firstVerseId":6158,"lastVerseId":6168,"startPage":600,"endPage":600,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6158,"surah":101,"ayah":1,"key":"101:1","numberInSurah":"١","text":"ٱلۡقَارِعَةُ","transliteration":"AlqariAAatu","translation":"The Striking Calamity","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6159,"surah":101,"ayah":2,"key":"101:2","numberInSurah":"٢","text":"مَا ٱلۡقَارِعَةُ","transliteration":"Ma alqariAAatu","translation":"What is the Striking Calamity","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6160,"surah":101,"ayah":3,"key":"101:3","numberInSurah":"٣","text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","transliteration":"Wama adraka ma alqariAAatu","translation":"And what can make you know what is the Striking Calamity","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6161,"surah":101,"ayah":4,"key":"101:4","numberInSurah":"٤","text":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","transliteration":"Yawma yakoonu alnnasu kaalfarashi almabthoothi","translation":"It is the Day when people will be like moths, dispersed","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6162,"surah":101,"ayah":5,"key":"101:5","numberInSurah":"٥","text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","transliteration":"Watakoonu aljibalu kaalAAihni almanfooshi","translation":"And the mountains will be like wool, fluffed up","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6163,"surah":101,"ayah":6,"key":"101:6","numberInSurah":"٦","text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","transliteration":"Faamma man thaqulat mawazeenuhu","translation":"Then as for one whose scales are heavy [with good deeds]","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6164,"surah":101,"ayah":7,"key":"101:7","numberInSurah":"٧","text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","transliteration":"Fahuwa fee AAeeshatin radiyatin","translation":"He will be in a pleasant life","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6165,"surah":101,"ayah":8,"key":"101:8","numberInSurah":"٨","text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","transliteration":"Waamma man khaffat mawazeenuhu","translation":"But as for one whose scales are light","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6166,"surah":101,"ayah":9,"key":"101:9","numberInSurah":"٩","text":"فَأُمُّهُۥ هَاوِيَةٞ","transliteration":"Faommuhu hawiyatun","translation":"His refuge will be an abyss","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6167,"surah":101,"ayah":10,"key":"101:10","numberInSurah":"١٠","text":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","transliteration":"Wama adraka ma hiyah","translation":"And what can make you know what that is","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false},{"id":6168,"surah":101,"ayah":11,"key":"101:11","numberInSurah":"١١","text":"نَارٌ حَامِيَةُۢ","transliteration":"Narun hamiyatun","translation":"It is a Fire, intensely hot","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":543,"sajdah":false}]}
