{"chapter":{"id":104,"name":"الهُمَزة","nameSimple":"الهمزة","transliteration":"Al-Humazah","translation":"The Traducer","revelation":"meccan","revelationOrder":32,"versesCount":9,"rukuCount":1,"firstVerseId":6180,"lastVerseId":6188,"startPage":601,"endPage":601,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6180,"surah":104,"ayah":1,"key":"104:1","numberInSurah":"١","text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","transliteration":"Waylun likulli humazatin lumazatin","translation":"Woe to every scorner and mocker","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6181,"surah":104,"ayah":2,"key":"104:2","numberInSurah":"٢","text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","transliteration":"Allathee jamaAAa malan waAAaddadahu","translation":"Who collects wealth and [continuously] counts it","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6182,"surah":104,"ayah":3,"key":"104:3","numberInSurah":"٣","text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","transliteration":"Yahsabu anna malahu akhladahu","translation":"He thinks that his wealth will make him immortal","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6183,"surah":104,"ayah":4,"key":"104:4","numberInSurah":"٤","text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","transliteration":"Kalla layunbathanna fee alhutamati","translation":"No! He will surely be thrown into the Crusher","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6184,"surah":104,"ayah":5,"key":"104:5","numberInSurah":"٥","text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","transliteration":"Wama adraka ma alhutamatu","translation":"And what can make you know what is the Crusher","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6185,"surah":104,"ayah":6,"key":"104:6","numberInSurah":"٦","text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","transliteration":"Naru Allahi almooqadatu","translation":"It is the fire of Allah, [eternally] fueled","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6186,"surah":104,"ayah":7,"key":"104:7","numberInSurah":"٧","text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","transliteration":"Allatee tattaliAAu AAala alafidati","translation":"Which mounts directed at the hearts","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6187,"surah":104,"ayah":8,"key":"104:8","numberInSurah":"٨","text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","transliteration":"lnnaha AAalayhim musadatun","translation":"Indeed, Hellfire will be closed down upon them","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false},{"id":6188,"surah":104,"ayah":9,"key":"104:9","numberInSurah":"٩","text":"فِي عَمَدٖ مُّمَدَّدَةِۭ","transliteration":"Fee AAamadin mumaddadatin","translation":"In extended columns","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":546,"sajdah":false}]}
