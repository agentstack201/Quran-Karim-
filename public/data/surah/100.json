{"chapter":{"id":100,"name":"العَاديَات","nameSimple":"العاديات","transliteration":"Al-'Adiyat","translation":"The Courser","revelation":"meccan","revelationOrder":14,"versesCount":11,"rukuCount":1,"firstVerseId":6147,"lastVerseId":6157,"startPage":599,"endPage":600,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6147,"surah":100,"ayah":1,"key":"100:1","numberInSurah":"١","text":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","transliteration":"WaalAAadiyati dabhan","translation":"By the racers, panting","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6148,"surah":100,"ayah":2,"key":"100:2","numberInSurah":"٢","text":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","transliteration":"Faalmooriyati qadhan","translation":"And the producers of sparks [when] striking","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6149,"surah":100,"ayah":3,"key":"100:3","numberInSurah":"٣","text":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","transliteration":"Faalmugheerati subhan","translation":"And the chargers at dawn","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6150,"surah":100,"ayah":4,"key":"100:4","numberInSurah":"٤","text":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","transliteration":"Faatharna bihi naqAAan","translation":"Stirring up thereby [clouds of] dust","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6151,"surah":100,"ayah":5,"key":"100:5","numberInSurah":"٥","text":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","transliteration":"Fawasatna bihi jamAAan","translation":"Arriving thereby in the center collectively","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6152,"surah":100,"ayah":6,"key":"100:6","numberInSurah":"٦","text":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","transliteration":"Inna alinsana lirabbihi lakanoodun","translation":"Indeed mankind, to his Lord, is ungrateful","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6153,"surah":100,"ayah":7,"key":"100:7","numberInSurah":"٧","text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","transliteration":"Wainnahu AAala thalika lashaheedun","translation":"And indeed, he is to that a witness","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6154,"surah":100,"ayah":8,"key":"100:8","numberInSurah":"٨","text":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","transliteration":"Wainnahu lihubbi alkhayri lashadeedun","translation":"And indeed he is, in love of wealth, intense","page":599,"juz":30,"hizb":60,"rubAlHizb":239,"ruku":542,"sajdah":false},{"id":6155,"surah":100,"ayah":9,"key":"100:9","numberInSurah":"٩","text":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","transliteration":"Afala yaAAlamu itha buAAthira ma fee alquboori","translation":"But does he not know that when the contents of the graves are scattered","page":599,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":542,"sajdah":false},{"id":6156,"surah":100,"ayah":10,"key":"100:10","numberInSurah":"١٠","text":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","transliteration":"Wahussila ma fee alssudoori","translation":"And that within the breasts is obtained","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":542,"sajdah":false},{"id":6157,"surah":100,"ayah":11,"key":"100:11","numberInSurah":"١١","text":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ","transliteration":"Inna rabbahum bihim yawmaithin lakhabeerun","translation":"Indeed, their Lord with them, that Day, is [fully] Acquainted","page":600,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":542,"sajdah":false}]}
