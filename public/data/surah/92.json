{"chapter":{"id":92,"name":"اللَّيل","nameSimple":"الليل","transliteration":"Al-Layl","translation":"The Night","revelation":"meccan","revelationOrder":9,"versesCount":21,"rukuCount":1,"firstVerseId":6059,"lastVerseId":6079,"startPage":595,"endPage":596,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6059,"surah":92,"ayah":1,"key":"92:1","numberInSurah":"١","text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","transliteration":"Waallayli itha yaghsha","translation":"By the night when it covers","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6060,"surah":92,"ayah":2,"key":"92:2","numberInSurah":"٢","text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","transliteration":"Waalnnahari itha tajalla","translation":"And [by] the day when it appears","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6061,"surah":92,"ayah":3,"key":"92:3","numberInSurah":"٣","text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","transliteration":"Wama khalaqa alththakara waalontha","translation":"And [by] He who created the male and female","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6062,"surah":92,"ayah":4,"key":"92:4","numberInSurah":"٤","text":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","transliteration":"Inna saAAyakum lashatta","translation":"Indeed, your efforts are diverse","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6063,"surah":92,"ayah":5,"key":"92:5","numberInSurah":"٥","text":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","transliteration":"Faamma man aAAta waittaqa","translation":"As for he who gives and fears Allah","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6064,"surah":92,"ayah":6,"key":"92:6","numberInSurah":"٦","text":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","transliteration":"Wasaddaqa bialhusna","translation":"And believes in the best [reward]","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6065,"surah":92,"ayah":7,"key":"92:7","numberInSurah":"٧","text":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","transliteration":"Fasanuyassiruhu lilyusra","translation":"We will ease him toward ease","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6066,"surah":92,"ayah":8,"key":"92:8","numberInSurah":"٨","text":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","transliteration":"Waamma man bakhila waistaghna","translation":"But as for he who withholds and considers himself free of need","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6067,"surah":92,"ayah":9,"key":"92:9","numberInSurah":"٩","text":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","transliteration":"Wakaththaba bialhusna","translation":"And denies the best [reward]","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6068,"surah":92,"ayah":10,"key":"92:10","numberInSurah":"١٠","text":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","transliteration":"Fasanuyassiruhu lilAAusra","translation":"We will ease him toward difficulty","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6069,"surah":92,"ayah":11,"key":"92:11","numberInSurah":"١١","text":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","transliteration":"Wama yughnee AAanhu maluhu itha taradda","translation":"And what will his wealth avail him when he falls","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6070,"surah":92,"ayah":12,"key":"92:12","numberInSurah":"١٢","text":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","transliteration":"Inna AAalayna lalhuda","translation":"Indeed, [incumbent] upon Us is guidance","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6071,"surah":92,"ayah":13,"key":"92:13","numberInSurah":"١٣","text":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ","transliteration":"Wainna lana lalakhirata waaloola","translation":"And indeed, to Us belongs the Hereafter and the first [life]","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6072,"surah":92,"ayah":14,"key":"92:14","numberInSurah":"١٤","text":"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ","transliteration":"Faanthartukum naran talaththa","translation":"So I have warned you of a Fire which is blazing","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6073,"surah":92,"ayah":15,"key":"92:15","numberInSurah":"١٥","text":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى","transliteration":"La yaslaha illa alashqa","translation":"None will [enter to] burn therein except the most wretched one","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6074,"surah":92,"ayah":16,"key":"92:16","numberInSurah":"١٦","text":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ","transliteration":"Allathee kaththaba watawalla","translation":"Who had denied and turned away","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6075,"surah":92,"ayah":17,"key":"92:17","numberInSurah":"١٧","text":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى","transliteration":"Wasayujannabuha alatqa","translation":"But the righteous one will avoid it","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6076,"surah":92,"ayah":18,"key":"92:18","numberInSurah":"١٨","text":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ","transliteration":"Allathee yutee malahu yatazakka","translation":"[He] who gives [from] his wealth to purify himself","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6077,"surah":92,"ayah":19,"key":"92:19","numberInSurah":"١٩","text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ","transliteration":"Wama liahadin AAindahu min niAAmatin tujza","translation":"And not [giving] for anyone who has [done him] a favor to be rewarded","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6078,"surah":92,"ayah":20,"key":"92:20","numberInSurah":"٢٠","text":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","transliteration":"Illa ibtighaa wajhi rabbihi alaAAla","translation":"But only seeking the countenance of his Lord, Most High","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false},{"id":6079,"surah":92,"ayah":21,"key":"92:21","numberInSurah":"٢١","text":"وَلَسَوۡفَ يَرۡضَىٰ","transliteration":"Walasawfa yarda","translation":"And he is going to be satisfied","page":596,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":534,"sajdah":false}]}
