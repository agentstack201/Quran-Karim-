{"chapter":{"id":106,"name":"قُرَيش","nameSimple":"قريش","transliteration":"Quraysh","translation":"Quraysh","revelation":"meccan","revelationOrder":29,"versesCount":4,"rukuCount":1,"firstVerseId":6194,"lastVerseId":6197,"startPage":602,"endPage":602,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6194,"surah":106,"ayah":1,"key":"106:1","numberInSurah":"١","text":"لِإِيلَٰفِ قُرَيۡشٍ","transliteration":"Lieelafi qurayshin","translation":"For the accustomed security of the Quraysh","page":602,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":548,"sajdah":false},{"id":6195,"surah":106,"ayah":2,"key":"106:2","numberInSurah":"٢","text":"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ","transliteration":"Eelafihim rihlata alshshitai waalssayfi","translation":"Their accustomed security [in] the caravan of winter and summer","page":602,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":548,"sajdah":false},{"id":6196,"surah":106,"ayah":3,"key":"106:3","numberInSurah":"٣","text":"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ","transliteration":"FalyaAAbudoo rabba hatha albayti","translation":"Let them worship the Lord of this House","page":602,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":548,"sajdah":false},{"id":6197,"surah":106,"ayah":4,"key":"106:4","numberInSurah":"٤","text":"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ","transliteration":"Allathee atAAamahum min jooAAin waamanahum min khawfin","translation":"Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear","page":602,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":548,"sajdah":false}]}
