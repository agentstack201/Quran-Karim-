{"chapter":{"id":75,"name":"القِيَامة","nameSimple":"القيامة","transliteration":"Al-Qiyamah","translation":"The Resurrection","revelation":"meccan","revelationOrder":31,"versesCount":40,"rukuCount":2,"firstVerseId":5552,"lastVerseId":5591,"startPage":577,"endPage":578,"startJuz":29,"endJuz":29,"hasBasmalah":true},"verses":[{"id":5552,"surah":75,"ayah":1,"key":"75:1","numberInSurah":"١","text":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ","transliteration":"La oqsimu biyawmi alqiyamati","translation":"I swear by the Day of Resurrection","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5553,"surah":75,"ayah":2,"key":"75:2","numberInSurah":"٢","text":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ","transliteration":"Wala oqsimu bialnnafsi allawwamati","translation":"And I swear by the reproaching soul [to the certainty of resurrection]","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5554,"surah":75,"ayah":3,"key":"75:3","numberInSurah":"٣","text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","transliteration":"Ayahsabu alinsanu allan najmaAAa AAithamahu","translation":"Does man think that We will not assemble his bones","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5555,"surah":75,"ayah":4,"key":"75:4","numberInSurah":"٤","text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ","transliteration":"Bala qadireena AAala an nusawwiya bananahu","translation":"Yes. [We are] Able [even] to proportion his fingertips","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5556,"surah":75,"ayah":5,"key":"75:5","numberInSurah":"٥","text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","transliteration":"Bal yureedu alinsanu liyafjura amamahu","translation":"But man desires to continue in sin","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5557,"surah":75,"ayah":6,"key":"75:6","numberInSurah":"٦","text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ","transliteration":"Yasalu ayyana yawmu alqiyamati","translation":"He asks, \"When is the Day of Resurrection","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5558,"surah":75,"ayah":7,"key":"75:7","numberInSurah":"٧","text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ","transliteration":"Faitha bariqa albasaru","translation":"So when vision is dazzled","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5559,"surah":75,"ayah":8,"key":"75:8","numberInSurah":"٨","text":"وَخَسَفَ ٱلۡقَمَرُ","transliteration":"Wakhasafa alqamaru","translation":"And the moon darkens","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5560,"surah":75,"ayah":9,"key":"75:9","numberInSurah":"٩","text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","transliteration":"WajumiAAa alshshamsu waalqamaru","translation":"And the sun and the moon are joined","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5561,"surah":75,"ayah":10,"key":"75:10","numberInSurah":"١٠","text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ","transliteration":"Yaqoolu alinsanu yawmaithin ayna almafarru","translation":"Man will say on that Day, \"Where is the [place of] escape","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5562,"surah":75,"ayah":11,"key":"75:11","numberInSurah":"١١","text":"كَلَّا لَا وَزَرَ","transliteration":"Kalla la wazara","translation":"No! There is no refuge","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5563,"surah":75,"ayah":12,"key":"75:12","numberInSurah":"١٢","text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ","transliteration":"Ila rabbika yawmaithin almustaqarru","translation":"To your Lord, that Day, is the [place of] permanence","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5564,"surah":75,"ayah":13,"key":"75:13","numberInSurah":"١٣","text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ","transliteration":"Yunabbao alinsanu yawmaithin bima qaddama waakhkhara","translation":"Man will be informed that Day of what he sent ahead and kept back","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5565,"surah":75,"ayah":14,"key":"75:14","numberInSurah":"١٤","text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","transliteration":"Bali alinsanu AAala nafsihi baseeratun","translation":"Rather, man, against himself, will be a witness","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5566,"surah":75,"ayah":15,"key":"75:15","numberInSurah":"١٥","text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","transliteration":"Walaw alqa maAAatheerahu","translation":"Even if he presents his excuses","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5567,"surah":75,"ayah":16,"key":"75:16","numberInSurah":"١٦","text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","transliteration":"La tuharrik bihi lisanaka litaAAjala bihi","translation":"Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5568,"surah":75,"ayah":17,"key":"75:17","numberInSurah":"١٧","text":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ","transliteration":"Inna AAalayna jamAAahu waquranahu","translation":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5569,"surah":75,"ayah":18,"key":"75:18","numberInSurah":"١٨","text":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ","transliteration":"Faitha qaranahu faittabiAA quranahu","translation":"So when We have recited it [through Gabriel], then follow its recitation","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5570,"surah":75,"ayah":19,"key":"75:19","numberInSurah":"١٩","text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","transliteration":"Thumma inna AAalayna bayanahu","translation":"Then upon Us is its clarification [to you]","page":577,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5571,"surah":75,"ayah":20,"key":"75:20","numberInSurah":"٢٠","text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ","transliteration":"Kalla bal tuhibboona alAAajilata","translation":"No! But you love the immediate","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5572,"surah":75,"ayah":21,"key":"75:21","numberInSurah":"٢١","text":"وَتَذَرُونَ ٱلۡأٓخِرَةَ","transliteration":"Watatharoona alakhirata","translation":"And leave the Hereafter","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5573,"surah":75,"ayah":22,"key":"75:22","numberInSurah":"٢٢","text":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ","transliteration":"Wujoohun yawmaithin nadiratun","translation":"[Some] faces, that Day, will be radiant","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5574,"surah":75,"ayah":23,"key":"75:23","numberInSurah":"٢٣","text":"إِلَىٰ رَبِّهَا نَاظِرَةٞ","transliteration":"Ila rabbiha nathiratun","translation":"Looking at their Lord","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5575,"surah":75,"ayah":24,"key":"75:24","numberInSurah":"٢٤","text":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ","transliteration":"Wawujoohun yawmaithin basiratun","translation":"And [some] faces, that Day, will be contorted","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5576,"surah":75,"ayah":25,"key":"75:25","numberInSurah":"٢٥","text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ","transliteration":"Tathunnu an yufAAala biha faqiratun","translation":"Expecting that there will be done to them [something] backbreaking","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5577,"surah":75,"ayah":26,"key":"75:26","numberInSurah":"٢٦","text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ","transliteration":"Kalla itha balaghati alttaraqiya","translation":"No! When the soul has reached the collar bones","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5578,"surah":75,"ayah":27,"key":"75:27","numberInSurah":"٢٧","text":"وَقِيلَ مَنۡۜ رَاقٖ","transliteration":"Waqeela man raqin","translation":"And it is said, \"Who will cure [him]","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5579,"surah":75,"ayah":28,"key":"75:28","numberInSurah":"٢٨","text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ","transliteration":"Wathanna annahu alfiraqu","translation":"And the dying one is certain that it is the [time of] separation","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5580,"surah":75,"ayah":29,"key":"75:29","numberInSurah":"٢٩","text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","transliteration":"Wailtaffati alssaqu bialssaqi","translation":"And the leg is wound about the leg","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5581,"surah":75,"ayah":30,"key":"75:30","numberInSurah":"٣٠","text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ","transliteration":"Ila rabbika yawmaithin almasaqu","translation":"To your Lord, that Day, will be the procession","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":512,"sajdah":false},{"id":5582,"surah":75,"ayah":31,"key":"75:31","numberInSurah":"٣١","text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","transliteration":"Fala saddaqa wala salla","translation":"And the disbeliever had not believed, nor had he prayed","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5583,"surah":75,"ayah":32,"key":"75:32","numberInSurah":"٣٢","text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","transliteration":"Walakin kaththaba watawalla","translation":"But [instead], he denied and turned away","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5584,"surah":75,"ayah":33,"key":"75:33","numberInSurah":"٣٣","text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ","transliteration":"Thumma thahaba ila ahlihi yatamatta","translation":"And then he went to his people, swaggering [in pride]","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5585,"surah":75,"ayah":34,"key":"75:34","numberInSurah":"٣٤","text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ","transliteration":"Awla laka faawla","translation":"Woe to you, and woe","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5586,"surah":75,"ayah":35,"key":"75:35","numberInSurah":"٣٥","text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ","transliteration":"Thumma awla laka faawla","translation":"Then woe to you, and woe","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5587,"surah":75,"ayah":36,"key":"75:36","numberInSurah":"٣٦","text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى","transliteration":"Ayahsabu alinsanu an yutraka sudan","translation":"Does man think that he will be left neglected","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5588,"surah":75,"ayah":37,"key":"75:37","numberInSurah":"٣٧","text":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ","transliteration":"Alam yaku nutfatan min manayyin yumna","translation":"Had he not been a sperm from semen emitted","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5589,"surah":75,"ayah":38,"key":"75:38","numberInSurah":"٣٨","text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ","transliteration":"Thumma kana AAalaqatan fakhalaqa fasawwa","translation":"Then he was a clinging clot, and [Allah] created [his form] and proportioned [him]","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5590,"surah":75,"ayah":39,"key":"75:39","numberInSurah":"٣٩","text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","transliteration":"FajaAAala minhu alzzawjayni alththakara waalontha","translation":"And made of him two mates, the male and the female","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false},{"id":5591,"surah":75,"ayah":40,"key":"75:40","numberInSurah":"٤٠","text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","transliteration":"Alaysa thalika biqadirin AAala an yuhyiya almawta","translation":"Is not that [Creator] Able to give life to the dead","page":578,"juz":29,"hizb":58,"rubAlHizb":231,"ruku":513,"sajdah":false}]}
