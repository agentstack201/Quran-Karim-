{"chapter":{"id":80,"name":"عَبَسَ","nameSimple":"عبس","transliteration":"'Abasa","translation":"He Frowned","revelation":"meccan","revelationOrder":24,"versesCount":42,"rukuCount":1,"firstVerseId":5759,"lastVerseId":5800,"startPage":585,"endPage":585,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5759,"surah":80,"ayah":1,"key":"80:1","numberInSurah":"١","text":"عَبَسَ وَتَوَلَّىٰٓ","transliteration":"AAabasa watawalla","translation":"The Prophet frowned and turned away","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5760,"surah":80,"ayah":2,"key":"80:2","numberInSurah":"٢","text":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","transliteration":"An jaahu alaAAma","translation":"Because there came to him the blind man, [interrupting]","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5761,"surah":80,"ayah":3,"key":"80:3","numberInSurah":"٣","text":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","transliteration":"Wama yudreeka laAAallahu yazzakka","translation":"But what would make you perceive, [O Muhammad], that perhaps he might be purified","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5762,"surah":80,"ayah":4,"key":"80:4","numberInSurah":"٤","text":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","transliteration":"Aw yaththakkaru fatanfaAAahu alththikra","translation":"Or be reminded and the remembrance would benefit him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5763,"surah":80,"ayah":5,"key":"80:5","numberInSurah":"٥","text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","transliteration":"Amma mani istaghna","translation":"As for he who thinks himself without need","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5764,"surah":80,"ayah":6,"key":"80:6","numberInSurah":"٦","text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","transliteration":"Faanta lahu tasadda","translation":"To him you give attention","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5765,"surah":80,"ayah":7,"key":"80:7","numberInSurah":"٧","text":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","transliteration":"Wama AAalayka alla yazzakka","translation":"And not upon you [is any blame] if he will not be purified","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5766,"surah":80,"ayah":8,"key":"80:8","numberInSurah":"٨","text":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","transliteration":"Waamma man jaaka yasAAa","translation":"But as for he who came to you striving [for knowledge]","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5767,"surah":80,"ayah":9,"key":"80:9","numberInSurah":"٩","text":"وَهُوَ يَخۡشَىٰ","transliteration":"Wahuwa yakhsha","translation":"While he fears [Allah]","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5768,"surah":80,"ayah":10,"key":"80:10","numberInSurah":"١٠","text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","transliteration":"Faanta AAanhu talahha","translation":"From him you are distracted","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5769,"surah":80,"ayah":11,"key":"80:11","numberInSurah":"١١","text":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","transliteration":"Kalla innaha tathkiratun","translation":"No! Indeed, these verses are a reminder","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5770,"surah":80,"ayah":12,"key":"80:12","numberInSurah":"١٢","text":"فَمَن شَآءَ ذَكَرَهُۥ","transliteration":"Faman shaa thakarahu","translation":"So whoever wills may remember it","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5771,"surah":80,"ayah":13,"key":"80:13","numberInSurah":"١٣","text":"فِي صُحُفٖ مُّكَرَّمَةٖ","transliteration":"Fee suhufin mukarramatin","translation":"[It is recorded] in honored sheets","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5772,"surah":80,"ayah":14,"key":"80:14","numberInSurah":"١٤","text":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","transliteration":"MarfooAAatin mutahharatin","translation":"Exalted and purified","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5773,"surah":80,"ayah":15,"key":"80:15","numberInSurah":"١٥","text":"بِأَيۡدِي سَفَرَةٖ","transliteration":"Biaydee safaratin","translation":"[Carried] by the hands of messenger-angels","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5774,"surah":80,"ayah":16,"key":"80:16","numberInSurah":"١٦","text":"كِرَامِۭ بَرَرَةٖ","transliteration":"Kiramin bararatin","translation":"Noble and dutiful","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5775,"surah":80,"ayah":17,"key":"80:17","numberInSurah":"١٧","text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","transliteration":"Qutila alinsanu ma akfarahu","translation":"Cursed is man; how disbelieving is he","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5776,"surah":80,"ayah":18,"key":"80:18","numberInSurah":"١٨","text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","transliteration":"Min ayyi shayin khalaqahu","translation":"From what substance did He create him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5777,"surah":80,"ayah":19,"key":"80:19","numberInSurah":"١٩","text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","transliteration":"Min nutfatin khalaqahu faqaddarahu","translation":"From a sperm-drop He created him and destined for him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5778,"surah":80,"ayah":20,"key":"80:20","numberInSurah":"٢٠","text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","transliteration":"Thumma alssabeela yassarahu","translation":"Then He eased the way for him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5779,"surah":80,"ayah":21,"key":"80:21","numberInSurah":"٢١","text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","transliteration":"Thumma amatahu faaqbarahu","translation":"Then He causes his death and provides a grave for him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5780,"surah":80,"ayah":22,"key":"80:22","numberInSurah":"٢٢","text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","transliteration":"Thumma itha shaa ansharahu","translation":"Then when He wills, He will resurrect him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5781,"surah":80,"ayah":23,"key":"80:23","numberInSurah":"٢٣","text":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","transliteration":"Kalla lamma yaqdi ma amarahu","translation":"No! Man has not yet accomplished what He commanded him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5782,"surah":80,"ayah":24,"key":"80:24","numberInSurah":"٢٤","text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","transliteration":"Falyanthuri alinsanu ila taAAamihi","translation":"Then let mankind look at his food","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5783,"surah":80,"ayah":25,"key":"80:25","numberInSurah":"٢٥","text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","transliteration":"Anna sababna almaa sabban","translation":"How We poured down water in torrents","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5784,"surah":80,"ayah":26,"key":"80:26","numberInSurah":"٢٦","text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","transliteration":"Thumma shaqaqna alarda shaqqan","translation":"Then We broke open the earth, splitting [it with sprouts]","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5785,"surah":80,"ayah":27,"key":"80:27","numberInSurah":"٢٧","text":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","transliteration":"Faanbatna feeha habban","translation":"And caused to grow within it grain","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5786,"surah":80,"ayah":28,"key":"80:28","numberInSurah":"٢٨","text":"وَعِنَبٗا وَقَضۡبٗا","transliteration":"WaAAinaban waqadban","translation":"And grapes and herbage","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5787,"surah":80,"ayah":29,"key":"80:29","numberInSurah":"٢٩","text":"وَزَيۡتُونٗا وَنَخۡلٗا","transliteration":"Wazaytoonan wanakhlan","translation":"And olive and palm trees","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5788,"surah":80,"ayah":30,"key":"80:30","numberInSurah":"٣٠","text":"وَحَدَآئِقَ غُلۡبٗا","transliteration":"Wahadaiqa ghulban","translation":"And gardens of dense shrubbery","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5789,"surah":80,"ayah":31,"key":"80:31","numberInSurah":"٣١","text":"وَفَٰكِهَةٗ وَأَبّٗا","transliteration":"Wafakihatan waabban","translation":"And fruit and grass","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5790,"surah":80,"ayah":32,"key":"80:32","numberInSurah":"٣٢","text":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","transliteration":"MataAAan lakum walianAAamikum","translation":"[As] enjoyment for you and your grazing livestock","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5791,"surah":80,"ayah":33,"key":"80:33","numberInSurah":"٣٣","text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","transliteration":"Faitha jaati alssakhkhatu","translation":"But when there comes the Deafening Blast","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5792,"surah":80,"ayah":34,"key":"80:34","numberInSurah":"٣٤","text":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","transliteration":"Yawma yafirru almaro min akheehi","translation":"On the Day a man will flee from his brother","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5793,"surah":80,"ayah":35,"key":"80:35","numberInSurah":"٣٥","text":"وَأُمِّهِۦ وَأَبِيهِ","transliteration":"Waommihi waabeehi","translation":"And his mother and his father","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5794,"surah":80,"ayah":36,"key":"80:36","numberInSurah":"٣٦","text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","transliteration":"Wasahibatihi wabaneehi","translation":"And his wife and his children","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5795,"surah":80,"ayah":37,"key":"80:37","numberInSurah":"٣٧","text":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ","transliteration":"Likulli imriin minhum yawmaithin shanun yughneehi","translation":"For every man, that Day, will be a matter adequate for him","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5796,"surah":80,"ayah":38,"key":"80:38","numberInSurah":"٣٨","text":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","transliteration":"Wujoohun yawmaithin musfiratun","translation":"[Some] faces, that Day, will be bright","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5797,"surah":80,"ayah":39,"key":"80:39","numberInSurah":"٣٩","text":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","transliteration":"Dahikatun mustabshiratun","translation":"Laughing, rejoicing at good news","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5798,"surah":80,"ayah":40,"key":"80:40","numberInSurah":"٤٠","text":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","transliteration":"Wawujoohun yawmaithin AAalayha ghabaratun","translation":"And [other] faces, that Day, will have upon them dust","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5799,"surah":80,"ayah":41,"key":"80:41","numberInSurah":"٤١","text":"تَرۡهَقُهَا قَتَرَةٌ","transliteration":"Tarhaquha qataratun","translation":"Blackness will cover them","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false},{"id":5800,"surah":80,"ayah":42,"key":"80:42","numberInSurah":"٤٢","text":"أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","transliteration":"Olaika humu alkafaratu alfajaratu","translation":"Those are the disbelievers, the wicked ones","page":585,"juz":30,"hizb":59,"rubAlHizb":234,"ruku":522,"sajdah":false}]}
