{"chapter":{"id":56,"name":"الوَاقِعة","nameSimple":"الواقعة","transliteration":"Al-Waqi'ah","translation":"The Inevitable","revelation":"meccan","revelationOrder":46,"versesCount":96,"rukuCount":3,"firstVerseId":4980,"lastVerseId":5075,"startPage":534,"endPage":537,"startJuz":27,"endJuz":27,"hasBasmalah":true},"verses":[{"id":4980,"surah":56,"ayah":1,"key":"56:1","numberInSurah":"١","text":"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ","transliteration":"Itha waqaAAati alwaqiAAatu","translation":"When the Occurrence occurs","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4981,"surah":56,"ayah":2,"key":"56:2","numberInSurah":"٢","text":"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ","transliteration":"Laysa liwaqAAatiha kathibatun","translation":"There is, at its occurrence, no denial","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4982,"surah":56,"ayah":3,"key":"56:3","numberInSurah":"٣","text":"خَافِضَةٞ رَّافِعَةٌ","transliteration":"Khafidatun rafiAAatun","translation":"It will bring down [some] and raise up [others]","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4983,"surah":56,"ayah":4,"key":"56:4","numberInSurah":"٤","text":"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا","transliteration":"Itha rujjati alardu rajjan","translation":"When the earth is shaken with convulsion","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4984,"surah":56,"ayah":5,"key":"56:5","numberInSurah":"٥","text":"وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا","transliteration":"Wabussati aljibalu bassan","translation":"And the mountains are broken down, crumbling","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4985,"surah":56,"ayah":6,"key":"56:6","numberInSurah":"٦","text":"فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا","transliteration":"Fakanat habaan munbaththan","translation":"And become dust dispersing","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4986,"surah":56,"ayah":7,"key":"56:7","numberInSurah":"٧","text":"وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ","transliteration":"Wakuntum azwajan thalathatan","translation":"And you become [of] three kinds","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4987,"surah":56,"ayah":8,"key":"56:8","numberInSurah":"٨","text":"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","transliteration":"Faashabu almaymanati ma ashabu almaymanati","translation":"Then the companions of the right - what are the companions of the right","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4988,"surah":56,"ayah":9,"key":"56:9","numberInSurah":"٩","text":"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","transliteration":"Waashabu almashamati ma ashabu almashamati","translation":"And the companions of the left - what are the companions of the left","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4989,"surah":56,"ayah":10,"key":"56:10","numberInSurah":"١٠","text":"وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ","transliteration":"Waalssabiqoona alssabiqoona","translation":"And the forerunners, the forerunners","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4990,"surah":56,"ayah":11,"key":"56:11","numberInSurah":"١١","text":"أُوْلَـٰٓئِكَ ٱلۡمُقَرَّبُونَ","transliteration":"Olaika almuqarraboona","translation":"Those are the ones brought near [to Allah]","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4991,"surah":56,"ayah":12,"key":"56:12","numberInSurah":"١٢","text":"فِي جَنَّـٰتِ ٱلنَّعِيمِ","transliteration":"Fee jannati alnnaAAeemi","translation":"In the Gardens of Pleasure","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4992,"surah":56,"ayah":13,"key":"56:13","numberInSurah":"١٣","text":"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ","transliteration":"Thullatun mina alawwaleena","translation":"A [large] company of the former peoples","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4993,"surah":56,"ayah":14,"key":"56:14","numberInSurah":"١٤","text":"وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ","transliteration":"Waqaleelun mina alakhireena","translation":"And a few of the later peoples","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4994,"surah":56,"ayah":15,"key":"56:15","numberInSurah":"١٥","text":"عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ","transliteration":"AAala sururin mawdoonatin","translation":"On thrones woven [with ornament]","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4995,"surah":56,"ayah":16,"key":"56:16","numberInSurah":"١٦","text":"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ","transliteration":"Muttakieena AAalayha mutaqabileena","translation":"Reclining on them, facing each other","page":534,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4996,"surah":56,"ayah":17,"key":"56:17","numberInSurah":"١٧","text":"يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ","transliteration":"Yatoofu AAalayhim wildanun mukhalladoona","translation":"There will circulate among them young boys made eternal","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4997,"surah":56,"ayah":18,"key":"56:18","numberInSurah":"١٨","text":"بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ","transliteration":"Biakwabin waabareeqa wakasin min maAAeenin","translation":"With vessels, pitchers and a cup [of wine] from a flowing spring","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4998,"surah":56,"ayah":19,"key":"56:19","numberInSurah":"١٩","text":"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ","transliteration":"La yusaddaAAoona AAanha wala yunzifoona","translation":"No headache will they have therefrom, nor will they be intoxicated","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":4999,"surah":56,"ayah":20,"key":"56:20","numberInSurah":"٢٠","text":"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ","transliteration":"Wafakihatin mimma yatakhayyaroona","translation":"And fruit of what they select","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5000,"surah":56,"ayah":21,"key":"56:21","numberInSurah":"٢١","text":"وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ","transliteration":"Walahmi tayrin mimma yashtahoona","translation":"And the meat of fowl, from whatever they desire","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5001,"surah":56,"ayah":22,"key":"56:22","numberInSurah":"٢٢","text":"وَحُورٌ عِينٞ","transliteration":"Wahoorun AAeenun","translation":"And [for them are] fair women with large, [beautiful] eyes","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5002,"surah":56,"ayah":23,"key":"56:23","numberInSurah":"٢٣","text":"كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ","transliteration":"Kaamthali allului almaknooni","translation":"The likenesses of pearls well-protected","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5003,"surah":56,"ayah":24,"key":"56:24","numberInSurah":"٢٤","text":"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ","transliteration":"Jazaan bima kanoo yaAAmaloona","translation":"As reward for what they used to do","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5004,"surah":56,"ayah":25,"key":"56:25","numberInSurah":"٢٥","text":"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا","transliteration":"La yasmaAAoona feeha laghwan wala tatheeman","translation":"They will not hear therein ill speech or commission of sin","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5005,"surah":56,"ayah":26,"key":"56:26","numberInSurah":"٢٦","text":"إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا","transliteration":"Illa qeelan salaman salaman","translation":"Only a saying: \"Peace, peace","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5006,"surah":56,"ayah":27,"key":"56:27","numberInSurah":"٢٧","text":"وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ","transliteration":"Waashabu alyameeni ma ashabu alyameeni","translation":"The companions of the right - what are the companions of the right","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5007,"surah":56,"ayah":28,"key":"56:28","numberInSurah":"٢٨","text":"فِي سِدۡرٖ مَّخۡضُودٖ","transliteration":"Fee sidrin makhdoodin","translation":"[They will be] among lote trees with thorns removed","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5008,"surah":56,"ayah":29,"key":"56:29","numberInSurah":"٢٩","text":"وَطَلۡحٖ مَّنضُودٖ","transliteration":"Watalhin mandoodin","translation":"And [banana] trees layered [with fruit]","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5009,"surah":56,"ayah":30,"key":"56:30","numberInSurah":"٣٠","text":"وَظِلّٖ مَّمۡدُودٖ","transliteration":"Wathillin mamdoodin","translation":"And shade extended","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5010,"surah":56,"ayah":31,"key":"56:31","numberInSurah":"٣١","text":"وَمَآءٖ مَّسۡكُوبٖ","transliteration":"Wamain maskoobin","translation":"And water poured out","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5011,"surah":56,"ayah":32,"key":"56:32","numberInSurah":"٣٢","text":"وَفَٰكِهَةٖ كَثِيرَةٖ","transliteration":"Wafakihatin katheeratin","translation":"And fruit, abundant [and varied]","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5012,"surah":56,"ayah":33,"key":"56:33","numberInSurah":"٣٣","text":"لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ","transliteration":"La maqtooAAatin wala mamnooAAatin","translation":"Neither limited [to season] nor forbidden","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5013,"surah":56,"ayah":34,"key":"56:34","numberInSurah":"٣٤","text":"وَفُرُشٖ مَّرۡفُوعَةٍ","transliteration":"Wafurushin marfooAAatin","translation":"And [upon] beds raised high","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5014,"surah":56,"ayah":35,"key":"56:35","numberInSurah":"٣٥","text":"إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ","transliteration":"Inna anshanahunna inshaan","translation":"Indeed, We have produced the women of Paradise in a [new] creation","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5015,"surah":56,"ayah":36,"key":"56:36","numberInSurah":"٣٦","text":"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا","transliteration":"FajaAAalnahunna abkaran","translation":"And made them virgins","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5016,"surah":56,"ayah":37,"key":"56:37","numberInSurah":"٣٧","text":"عُرُبًا أَتۡرَابٗا","transliteration":"AAuruban atraban","translation":"Devoted [to their husbands] and of equal age","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5017,"surah":56,"ayah":38,"key":"56:38","numberInSurah":"٣٨","text":"لِّأَصۡحَٰبِ ٱلۡيَمِينِ","transliteration":"Liashabi alyameeni","translation":"For the companions of the right [who are]","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":469,"sajdah":false},{"id":5018,"surah":56,"ayah":39,"key":"56:39","numberInSurah":"٣٩","text":"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ","transliteration":"Thullatun mina alawwaleena","translation":"A company of the former peoples","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5019,"surah":56,"ayah":40,"key":"56:40","numberInSurah":"٤٠","text":"وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ","transliteration":"Wathullatun mina alakhireena","translation":"And a company of the later peoples","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5020,"surah":56,"ayah":41,"key":"56:41","numberInSurah":"٤١","text":"وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ","transliteration":"Waashabu alshshimali ma ashabu alshshimali","translation":"And the companions of the left - what are the companions of the left","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5021,"surah":56,"ayah":42,"key":"56:42","numberInSurah":"٤٢","text":"فِي سَمُومٖ وَحَمِيمٖ","transliteration":"Fee samoomin wahameemin","translation":"[They will be] in scorching fire and scalding water","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5022,"surah":56,"ayah":43,"key":"56:43","numberInSurah":"٤٣","text":"وَظِلّٖ مِّن يَحۡمُومٖ","transliteration":"Wathillin min yahmoomin","translation":"And a shade of black smoke","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5023,"surah":56,"ayah":44,"key":"56:44","numberInSurah":"٤٤","text":"لَّا بَارِدٖ وَلَا كَرِيمٍ","transliteration":"La baridin wala kareemin","translation":"Neither cool nor beneficial","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5024,"surah":56,"ayah":45,"key":"56:45","numberInSurah":"٤٥","text":"إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ","transliteration":"Innahum kanoo qabla thalika mutrafeena","translation":"Indeed they were, before that, indulging in affluence","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5025,"surah":56,"ayah":46,"key":"56:46","numberInSurah":"٤٦","text":"وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ","transliteration":"Wakanoo yusirroona AAala alhinthi alAAatheemi","translation":"And they used to persist in the great violation","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5026,"surah":56,"ayah":47,"key":"56:47","numberInSurah":"٤٧","text":"وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ","transliteration":"Wakanoo yaqooloona aitha mitna wakunna turaban waAAithaman ainna lamabAAoothoona","translation":"And they used to say, \"When we die and become dust and bones, are we indeed to be resurrected","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5027,"surah":56,"ayah":48,"key":"56:48","numberInSurah":"٤٨","text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","transliteration":"Awa abaona alawwaloona","translation":"And our forefathers [as well]","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5028,"surah":56,"ayah":49,"key":"56:49","numberInSurah":"٤٩","text":"قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ","transliteration":"Qul inna alawwaleena waalakhireena","translation":"Say, [O Muhammad], \"Indeed, the former and the later peoples","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5029,"surah":56,"ayah":50,"key":"56:50","numberInSurah":"٥٠","text":"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ","transliteration":"LamajmooAAoona ila meeqati yawmin maAAloomin","translation":"Are to be gathered together for the appointment of a known Day","page":535,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5030,"surah":56,"ayah":51,"key":"56:51","numberInSurah":"٥١","text":"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ","transliteration":"Thumma innakum ayyuha alddalloona almukaththiboona","translation":"Then indeed you, O those astray [who are] deniers","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5031,"surah":56,"ayah":52,"key":"56:52","numberInSurah":"٥٢","text":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ","transliteration":"Laakiloona min shajarin min zaqqoomin","translation":"Will be eating from trees of zaqqum","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5032,"surah":56,"ayah":53,"key":"56:53","numberInSurah":"٥٣","text":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ","transliteration":"Famalioona minha albutoona","translation":"And filling with it your bellies","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5033,"surah":56,"ayah":54,"key":"56:54","numberInSurah":"٥٤","text":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ","transliteration":"Fashariboona AAalayhi mina alhameemi","translation":"And drinking on top of it from scalding water","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5034,"surah":56,"ayah":55,"key":"56:55","numberInSurah":"٥٥","text":"فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ","transliteration":"Fashariboona shurba alheemi","translation":"And will drink as the drinking of thirsty camels","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5035,"surah":56,"ayah":56,"key":"56:56","numberInSurah":"٥٦","text":"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ","transliteration":"Hatha nuzuluhum yawma alddeeni","translation":"That is their accommodation on the Day of Recompense","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5036,"surah":56,"ayah":57,"key":"56:57","numberInSurah":"٥٧","text":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ","transliteration":"Nahnu khalaqnakum falawla tusaddiqoona","translation":"We have created you, so why do you not believe","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5037,"surah":56,"ayah":58,"key":"56:58","numberInSurah":"٥٨","text":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ","transliteration":"Afaraaytum ma tumnoona","translation":"Have you seen that which you emit","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5038,"surah":56,"ayah":59,"key":"56:59","numberInSurah":"٥٩","text":"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ","transliteration":"Aantum takhluqoonahu am nahnu alkhaliqoona","translation":"Is it you who creates it, or are We the Creator","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5039,"surah":56,"ayah":60,"key":"56:60","numberInSurah":"٦٠","text":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","transliteration":"Nahnu qaddarna baynakumu almawta wama nahnu bimasbooqeena","translation":"We have decreed death among you, and We are not to be outdone","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5040,"surah":56,"ayah":61,"key":"56:61","numberInSurah":"٦١","text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ","transliteration":"AAala an nubaddila amthalakum wanunshiakum fee ma la taAAlamoona","translation":"In that We will change your likenesses and produce you in that [form] which you do not know","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5041,"surah":56,"ayah":62,"key":"56:62","numberInSurah":"٦٢","text":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ","transliteration":"Walaqad AAalimtumu alnnashata aloola falawla tathakkaroona","translation":"And you have already known the first creation, so will you not remember","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5042,"surah":56,"ayah":63,"key":"56:63","numberInSurah":"٦٣","text":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ","transliteration":"Afaraaytum ma tahruthoona","translation":"And have you seen that [seed] which you sow","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5043,"surah":56,"ayah":64,"key":"56:64","numberInSurah":"٦٤","text":"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّـٰرِعُونَ","transliteration":"Aantum tazraAAoonahu am nahnu alzzariAAoona","translation":"Is it you who makes it grow, or are We the grower","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5044,"surah":56,"ayah":65,"key":"56:65","numberInSurah":"٦٥","text":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ","transliteration":"Law nashao lajaAAalnahu hutaman fathaltum tafakkahoona","translation":"If We willed, We could make it [dry] debris, and you would remain in wonder","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5045,"surah":56,"ayah":66,"key":"56:66","numberInSurah":"٦٦","text":"إِنَّا لَمُغۡرَمُونَ","transliteration":"Inna lamughramoona","translation":"[Saying], \"Indeed, we are [now] in debt","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5046,"surah":56,"ayah":67,"key":"56:67","numberInSurah":"٦٧","text":"بَلۡ نَحۡنُ مَحۡرُومُونَ","transliteration":"Bal nahnu mahroomoona","translation":"Rather, we have been deprived","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5047,"surah":56,"ayah":68,"key":"56:68","numberInSurah":"٦٨","text":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ","transliteration":"Afaraaytumu almaa allathee tashraboona","translation":"And have you seen the water that you drink","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5048,"surah":56,"ayah":69,"key":"56:69","numberInSurah":"٦٩","text":"ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ","transliteration":"Aantum anzaltumoohu mina almuzni am nahnu almunziloona","translation":"Is it you who brought it down from the clouds, or is it We who bring it down","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5049,"surah":56,"ayah":70,"key":"56:70","numberInSurah":"٧٠","text":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ","transliteration":"Law nashao jaAAalnahu ojajan falawla tashkuroona","translation":"If We willed, We could make it bitter, so why are you not grateful","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5050,"surah":56,"ayah":71,"key":"56:71","numberInSurah":"٧١","text":"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ","transliteration":"Afaraaytumu alnnara allatee tooroona","translation":"And have you seen the fire that you ignite","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5051,"surah":56,"ayah":72,"key":"56:72","numberInSurah":"٧٢","text":"ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ","transliteration":"Aantum anshatum shajarataha am nahnu almunshioona","translation":"Is it you who produced its tree, or are We the producer","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5052,"surah":56,"ayah":73,"key":"56:73","numberInSurah":"٧٣","text":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ","transliteration":"Nahnu jaAAalnaha tathkiratan wamataAAan lilmuqweena","translation":"We have made it a reminder and provision for the travelers","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5053,"surah":56,"ayah":74,"key":"56:74","numberInSurah":"٧٤","text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","transliteration":"Fasabbih biismi rabbika alAAatheemi","translation":"So exalt the name of your Lord, the Most Great","page":536,"juz":27,"hizb":54,"rubAlHizb":214,"ruku":470,"sajdah":false},{"id":5054,"surah":56,"ayah":75,"key":"56:75","numberInSurah":"٧٥","text":"۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","transliteration":"Fala oqsimu bimawaqiAAi alnnujoomi","translation":"Then I swear by the setting of the stars","page":536,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5055,"surah":56,"ayah":76,"key":"56:76","numberInSurah":"٧٦","text":"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ","transliteration":"Wainnahu laqasamun law taAAlamoona AAatheemun","translation":"And indeed, it is an oath - if you could know - [most] great","page":536,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5056,"surah":56,"ayah":77,"key":"56:77","numberInSurah":"٧٧","text":"إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ","transliteration":"Innahu laquranun kareemun","translation":"Indeed, it is a noble Qur'an","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5057,"surah":56,"ayah":78,"key":"56:78","numberInSurah":"٧٨","text":"فِي كِتَٰبٖ مَّكۡنُونٖ","transliteration":"Fee kitabin maknoonin","translation":"In a Register well-protected","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5058,"surah":56,"ayah":79,"key":"56:79","numberInSurah":"٧٩","text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ","transliteration":"La yamassuhu illa almutahharoona","translation":"None touch it except the purified","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5059,"surah":56,"ayah":80,"key":"56:80","numberInSurah":"٨٠","text":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ","transliteration":"Tanzeelun min rabbi alAAalameena","translation":"[It is] a revelation from the Lord of the worlds","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5060,"surah":56,"ayah":81,"key":"56:81","numberInSurah":"٨١","text":"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ","transliteration":"Afabihatha alhadeethi antum mudhinoona","translation":"Then is it to this statement that you are indifferent","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5061,"surah":56,"ayah":82,"key":"56:82","numberInSurah":"٨٢","text":"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ","transliteration":"WatajAAaloona rizqakum annakum tukaththiboona","translation":"And make [the thanks for] your provision that you deny [the Provider]","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5062,"surah":56,"ayah":83,"key":"56:83","numberInSurah":"٨٣","text":"فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ","transliteration":"Falawla itha balaghati alhulqooma","translation":"Then why, when the soul at death reaches the throat","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5063,"surah":56,"ayah":84,"key":"56:84","numberInSurah":"٨٤","text":"وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ","transliteration":"Waantum heenaithin tanthuroona","translation":"And you are at that time looking on","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5064,"surah":56,"ayah":85,"key":"56:85","numberInSurah":"٨٥","text":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ","transliteration":"Wanahnu aqrabu ilayhi minkum walakin la tubsiroona","translation":"And Our angels are nearer to him than you, but you do not see","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5065,"surah":56,"ayah":86,"key":"56:86","numberInSurah":"٨٦","text":"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ","transliteration":"Falawla in kuntum ghayra madeeneena","translation":"Then why do you not, if you are not to be recompensed","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5066,"surah":56,"ayah":87,"key":"56:87","numberInSurah":"٨٧","text":"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ","transliteration":"TarjiAAoonaha in kuntum sadiqeena","translation":"Bring it back, if you should be truthful","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5067,"surah":56,"ayah":88,"key":"56:88","numberInSurah":"٨٨","text":"فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ","transliteration":"Faamma in kana mina almuqarrabeena","translation":"And if the deceased was of those brought near to Allah","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5068,"surah":56,"ayah":89,"key":"56:89","numberInSurah":"٨٩","text":"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ","transliteration":"Farawhun warayhanun wajannatu naAAeemin","translation":"Then [for him is] rest and bounty and a garden of pleasure","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5069,"surah":56,"ayah":90,"key":"56:90","numberInSurah":"٩٠","text":"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ","transliteration":"Waamma in kana min ashabi alyameeni","translation":"And if he was of the companions of the right","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5070,"surah":56,"ayah":91,"key":"56:91","numberInSurah":"٩١","text":"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ","transliteration":"Fasalamun laka min ashabi alyameeni","translation":"Then [the angels will say], \"Peace for you; [you are] from the companions of the right","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5071,"surah":56,"ayah":92,"key":"56:92","numberInSurah":"٩٢","text":"وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ","transliteration":"Waamma in kana mina almukaththibeena alddalleena","translation":"But if he was of the deniers [who were] astray","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5072,"surah":56,"ayah":93,"key":"56:93","numberInSurah":"٩٣","text":"فَنُزُلٞ مِّنۡ حَمِيمٖ","transliteration":"Fanuzulun min hameemin","translation":"Then [for him is] accommodation of scalding water","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5073,"surah":56,"ayah":94,"key":"56:94","numberInSurah":"٩٤","text":"وَتَصۡلِيَةُ جَحِيمٍ","transliteration":"Watasliyatu jaheemin","translation":"And burning in Hellfire","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5074,"surah":56,"ayah":95,"key":"56:95","numberInSurah":"٩٥","text":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ","transliteration":"Inna hatha lahuwa haqqu alyaqeeni","translation":"Indeed, this is the true certainty","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false},{"id":5075,"surah":56,"ayah":96,"key":"56:96","numberInSurah":"٩٦","text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","transliteration":"Fasabbih biismi rabbika alAAatheemi","translation":"So exalt the name of your Lord, the Most Great","page":537,"juz":27,"hizb":54,"rubAlHizb":215,"ruku":471,"sajdah":false}]}
