{"chapter":{"id":78,"name":"النَّبَإ","nameSimple":"النبإ","transliteration":"An-Naba","translation":"The Tidings","revelation":"meccan","revelationOrder":80,"versesCount":40,"rukuCount":2,"firstVerseId":5673,"lastVerseId":5712,"startPage":582,"endPage":583,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5673,"surah":78,"ayah":1,"key":"78:1","numberInSurah":"١","text":"عَمَّ يَتَسَآءَلُونَ","transliteration":"AAamma yatasaaloona","translation":"About what are they asking one another","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5674,"surah":78,"ayah":2,"key":"78:2","numberInSurah":"٢","text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ","transliteration":"AAani alnnabai alAAatheemi","translation":"About the great news","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5675,"surah":78,"ayah":3,"key":"78:3","numberInSurah":"٣","text":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","transliteration":"Allathee hum feehi mukhtalifoona","translation":"That over which they are in disagreement","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5676,"surah":78,"ayah":4,"key":"78:4","numberInSurah":"٤","text":"كَلَّا سَيَعۡلَمُونَ","transliteration":"Kalla sayaAAlamoona","translation":"No! They are going to know","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5677,"surah":78,"ayah":5,"key":"78:5","numberInSurah":"٥","text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ","transliteration":"Thumma kalla sayaAAlamoona","translation":"Then, no! They are going to know","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5678,"surah":78,"ayah":6,"key":"78:6","numberInSurah":"٦","text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا","transliteration":"Alam najAAali alarda mihadan","translation":"Have We not made the earth a resting place","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5679,"surah":78,"ayah":7,"key":"78:7","numberInSurah":"٧","text":"وَٱلۡجِبَالَ أَوۡتَادٗا","transliteration":"Waaljibala awtadan","translation":"And the mountains as stakes","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5680,"surah":78,"ayah":8,"key":"78:8","numberInSurah":"٨","text":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا","transliteration":"Wakhalaqnakum azwajan","translation":"And We created you in pairs","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5681,"surah":78,"ayah":9,"key":"78:9","numberInSurah":"٩","text":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا","transliteration":"WajaAAalna nawmakum subatan","translation":"And made your sleep [a means for] rest","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5682,"surah":78,"ayah":10,"key":"78:10","numberInSurah":"١٠","text":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا","transliteration":"WajaAAalna allayla libasan","translation":"And made the night as clothing","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5683,"surah":78,"ayah":11,"key":"78:11","numberInSurah":"١١","text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا","transliteration":"WajaAAalna alnnahara maAAashan","translation":"And made the day for livelihood","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5684,"surah":78,"ayah":12,"key":"78:12","numberInSurah":"١٢","text":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا","transliteration":"Wabanayna fawqakum sabAAan shidadan","translation":"And constructed above you seven strong [heavens]","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5685,"surah":78,"ayah":13,"key":"78:13","numberInSurah":"١٣","text":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا","transliteration":"WajaAAalna sirajan wahhajan","translation":"And made [therein] a burning lamp","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5686,"surah":78,"ayah":14,"key":"78:14","numberInSurah":"١٤","text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا","transliteration":"Waanzalna mina almuAAsirati maan thajjajan","translation":"And sent down, from the rain clouds, pouring water","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5687,"surah":78,"ayah":15,"key":"78:15","numberInSurah":"١٥","text":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا","transliteration":"Linukhrija bihi habban wanabatan","translation":"That We may bring forth thereby grain and vegetation","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5688,"surah":78,"ayah":16,"key":"78:16","numberInSurah":"١٦","text":"وَجَنَّـٰتٍ أَلۡفَافًا","transliteration":"Wajannatin alfafan","translation":"And gardens of entwined growth","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5689,"surah":78,"ayah":17,"key":"78:17","numberInSurah":"١٧","text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا","transliteration":"Inna yawma alfasli kana meeqatan","translation":"Indeed, the Day of Judgement is an appointed time","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5690,"surah":78,"ayah":18,"key":"78:18","numberInSurah":"١٨","text":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا","transliteration":"Yawma yunfakhu fee alssoori fatatoona afwajan","translation":"The Day the Horn is blown and you will come forth in multitudes","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5691,"surah":78,"ayah":19,"key":"78:19","numberInSurah":"١٩","text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا","transliteration":"Wafutihati alssamao fakanat abwaban","translation":"And the heaven is opened and will become gateways","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5692,"surah":78,"ayah":20,"key":"78:20","numberInSurah":"٢٠","text":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا","transliteration":"Wasuyyirati aljibalu fakanat saraban","translation":"And the mountains are removed and will be [but] a mirage","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5693,"surah":78,"ayah":21,"key":"78:21","numberInSurah":"٢١","text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا","transliteration":"Inna jahannama kanat mirsadan","translation":"Indeed, Hell has been lying in wait","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5694,"surah":78,"ayah":22,"key":"78:22","numberInSurah":"٢٢","text":"لِّلطَّـٰغِينَ مَـَٔابٗا","transliteration":"Lilttagheena maaban","translation":"For the transgressors, a place of return","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5695,"surah":78,"ayah":23,"key":"78:23","numberInSurah":"٢٣","text":"لَّـٰبِثِينَ فِيهَآ أَحۡقَابٗا","transliteration":"Labitheena feeha ahqaban","translation":"In which they will remain for ages [unending]","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5696,"surah":78,"ayah":24,"key":"78:24","numberInSurah":"٢٤","text":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا","transliteration":"La yathooqoona feeha bardan wala sharaban","translation":"They will not taste therein [any] coolness or drink","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5697,"surah":78,"ayah":25,"key":"78:25","numberInSurah":"٢٥","text":"إِلَّا حَمِيمٗا وَغَسَّاقٗا","transliteration":"Illa hameeman waghassaqan","translation":"Except scalding water and [foul] purulence","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5698,"surah":78,"ayah":26,"key":"78:26","numberInSurah":"٢٦","text":"جَزَآءٗ وِفَاقًا","transliteration":"Jazaan wifaqan","translation":"An appropriate recompense","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5699,"surah":78,"ayah":27,"key":"78:27","numberInSurah":"٢٧","text":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا","transliteration":"Innahum kanoo la yarjoona hisaban","translation":"Indeed, they were not expecting an account","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5700,"surah":78,"ayah":28,"key":"78:28","numberInSurah":"٢٨","text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا","transliteration":"Wakaththaboo biayatina kiththaban","translation":"And denied Our verses with [emphatic] denial","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5701,"surah":78,"ayah":29,"key":"78:29","numberInSurah":"٢٩","text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا","transliteration":"Wakulla shayin ahsaynahu kitaban","translation":"But all things We have enumerated in writing","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5702,"surah":78,"ayah":30,"key":"78:30","numberInSurah":"٣٠","text":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","transliteration":"Fathooqoo falan nazeedakum illa AAathaban","translation":"So taste [the penalty], and never will We increase you except in torment","page":582,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":518,"sajdah":false},{"id":5703,"surah":78,"ayah":31,"key":"78:31","numberInSurah":"٣١","text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","transliteration":"Inna lilmuttaqeena mafazan","translation":"Indeed, for the righteous is attainment","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5704,"surah":78,"ayah":32,"key":"78:32","numberInSurah":"٣٢","text":"حَدَآئِقَ وَأَعۡنَٰبٗا","transliteration":"Hadaiqa waaAAnaban","translation":"Gardens and grapevines","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5705,"surah":78,"ayah":33,"key":"78:33","numberInSurah":"٣٣","text":"وَكَوَاعِبَ أَتۡرَابٗا","transliteration":"WakawaAAiba atraban","translation":"And full-breasted [companions] of equal age","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5706,"surah":78,"ayah":34,"key":"78:34","numberInSurah":"٣٤","text":"وَكَأۡسٗا دِهَاقٗا","transliteration":"Wakasan dihaqan","translation":"And a full cup","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5707,"surah":78,"ayah":35,"key":"78:35","numberInSurah":"٣٥","text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّـٰبٗا","transliteration":"La yasmaAAoona feeha laghwan wala kiththaban","translation":"No ill speech will they hear therein or any falsehood","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5708,"surah":78,"ayah":36,"key":"78:36","numberInSurah":"٣٦","text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا","transliteration":"Jazaan min rabbika AAataan hisaban","translation":"[As] reward from your Lord, [a generous] gift [made due by] account","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5709,"surah":78,"ayah":37,"key":"78:37","numberInSurah":"٣٧","text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","transliteration":"Rabbi alssamawati waalardi wama baynahuma alrrahmani la yamlikoona minhu khitaban","translation":"[From] the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him [authority for] speech","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5710,"surah":78,"ayah":38,"key":"78:38","numberInSurah":"٣٨","text":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا","transliteration":"Yawma yaqoomu alrroohu waalmalaikatu saffan la yatakallamoona illa man athina lahu alrrahmanu waqala sawaban","translation":"The Day that the Spirit and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5711,"surah":78,"ayah":39,"key":"78:39","numberInSurah":"٣٩","text":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","transliteration":"Thalika alyawmu alhaqqu faman shaa ittakhatha ila rabbihi maaban","translation":"That is the True Day; so he who wills may take to his Lord a [way of] return","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false},{"id":5712,"surah":78,"ayah":40,"key":"78:40","numberInSurah":"٤٠","text":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","transliteration":"Inna antharnakum AAathaban qareeban yawma yanthuru almaro ma qaddamat yadahu wayaqoolu alkafiru ya laytanee kuntu turaban","translation":"Indeed, We have warned you of a near punishment on the Day when a man will observe what his hands have put forth and the disbeliever will say, \"Oh, I wish that I were dust","page":583,"juz":30,"hizb":59,"rubAlHizb":233,"ruku":519,"sajdah":false}]}
