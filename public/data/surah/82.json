{"chapter":{"id":82,"name":"الانفِطَار","nameSimple":"الإنفطار","transliteration":"Al-Infitar","translation":"The Cleaving","revelation":"meccan","revelationOrder":82,"versesCount":19,"rukuCount":1,"firstVerseId":5830,"lastVerseId":5848,"startPage":587,"endPage":587,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5830,"surah":82,"ayah":1,"key":"82:1","numberInSurah":"١","text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","transliteration":"Itha alssamao infatarat","translation":"When the sky breaks apart","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5831,"surah":82,"ayah":2,"key":"82:2","numberInSurah":"٢","text":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","transliteration":"Waitha alkawakibu intatharat","translation":"And when the stars fall, scattering","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5832,"surah":82,"ayah":3,"key":"82:3","numberInSurah":"٣","text":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","transliteration":"Waitha albiharu fujjirat","translation":"And when the seas are erupted","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5833,"surah":82,"ayah":4,"key":"82:4","numberInSurah":"٤","text":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","transliteration":"Waitha alqubooru buAAthirat","translation":"And when the [contents of] graves are scattered","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5834,"surah":82,"ayah":5,"key":"82:5","numberInSurah":"٥","text":"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","transliteration":"AAalimat nafsun ma qaddamat waakhkharat","translation":"A soul will [then] know what it has put forth and kept back","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5835,"surah":82,"ayah":6,"key":"82:6","numberInSurah":"٦","text":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","transliteration":"Ya ayyuha alinsanu ma gharraka birabbika alkareemi","translation":"O mankind, what has deceived you concerning your Lord, the Generous","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5836,"surah":82,"ayah":7,"key":"82:7","numberInSurah":"٧","text":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","transliteration":"Allathee khalaqaka fasawwaka faAAadalaka","translation":"Who created you, proportioned you, and balanced you","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5837,"surah":82,"ayah":8,"key":"82:8","numberInSurah":"٨","text":"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ","transliteration":"Fee ayyi sooratin ma shaa rakkabaka","translation":"In whatever form He willed has He assembled you","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5838,"surah":82,"ayah":9,"key":"82:9","numberInSurah":"٩","text":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","transliteration":"Kalla bal tukaththiboona bialddeeni","translation":"No! But you deny the Recompense","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5839,"surah":82,"ayah":10,"key":"82:10","numberInSurah":"١٠","text":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","transliteration":"Wainna AAalaykum lahafitheena","translation":"And indeed, [appointed] over you are keepers","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5840,"surah":82,"ayah":11,"key":"82:11","numberInSurah":"١١","text":"كِرَامٗا كَٰتِبِينَ","transliteration":"Kiraman katibeena","translation":"Noble and recording","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5841,"surah":82,"ayah":12,"key":"82:12","numberInSurah":"١٢","text":"يَعۡلَمُونَ مَا تَفۡعَلُونَ","transliteration":"YaAAlamoona ma tafAAaloona","translation":"They know whatever you do","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5842,"surah":82,"ayah":13,"key":"82:13","numberInSurah":"١٣","text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ","transliteration":"Inna alabrara lafee naAAeemin","translation":"Indeed, the righteous will be in pleasure","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5843,"surah":82,"ayah":14,"key":"82:14","numberInSurah":"١٤","text":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ","transliteration":"Wainna alfujjara lafee jaheemin","translation":"And indeed, the wicked will be in Hellfire","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5844,"surah":82,"ayah":15,"key":"82:15","numberInSurah":"١٥","text":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ","transliteration":"Yaslawnaha yawma alddeeni","translation":"They will [enter to] burn therein on the Day of Recompense","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5845,"surah":82,"ayah":16,"key":"82:16","numberInSurah":"١٦","text":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","transliteration":"Wama hum AAanha bighaibeena","translation":"And never therefrom will they be absent","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5846,"surah":82,"ayah":17,"key":"82:17","numberInSurah":"١٧","text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","transliteration":"Wama adraka ma yawmu alddeeni","translation":"And what can make you know what is the Day of Recompense","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5847,"surah":82,"ayah":18,"key":"82:18","numberInSurah":"١٨","text":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","transliteration":"Thumma ma adraka ma yawmu alddeeni","translation":"Then, what can make you know what is the Day of Recompense","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false},{"id":5848,"surah":82,"ayah":19,"key":"82:19","numberInSurah":"١٩","text":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ","transliteration":"Yawma la tamliku nafsun linafsin shayan waalamru yawmaithin lillahi","translation":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah","page":587,"juz":30,"hizb":59,"rubAlHizb":235,"ruku":524,"sajdah":false}]}
