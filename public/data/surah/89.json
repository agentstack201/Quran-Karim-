{"chapter":{"id":89,"name":"الفَجر","nameSimple":"الفجر","transliteration":"Al-Fajr","translation":"The Dawn","revelation":"meccan","revelationOrder":10,"versesCount":30,"rukuCount":1,"firstVerseId":5994,"lastVerseId":6023,"startPage":593,"endPage":594,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5994,"surah":89,"ayah":1,"key":"89:1","numberInSurah":"١","text":"وَٱلۡفَجۡرِ","transliteration":"Waalfajri","translation":"By the dawn","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":5995,"surah":89,"ayah":2,"key":"89:2","numberInSurah":"٢","text":"وَلَيَالٍ عَشۡرٖ","transliteration":"Walayalin AAashrin","translation":"And [by] ten nights","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":5996,"surah":89,"ayah":3,"key":"89:3","numberInSurah":"٣","text":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ","transliteration":"WaalshshafAAi waalwatri","translation":"And [by] the even [number] and the odd","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":5997,"surah":89,"ayah":4,"key":"89:4","numberInSurah":"٤","text":"وَٱلَّيۡلِ إِذَا يَسۡرِ","transliteration":"Waallayli itha yasri","translation":"And [by] the night when it passes","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":5998,"surah":89,"ayah":5,"key":"89:5","numberInSurah":"٥","text":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ","transliteration":"Hal fee thalika qasamun lithee hijrin","translation":"Is there [not] in [all] that an oath [sufficient] for one of perception","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":5999,"surah":89,"ayah":6,"key":"89:6","numberInSurah":"٦","text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","transliteration":"Alam tara kayfa faAAala rabbuka biAAadin","translation":"Have you not considered how your Lord dealt with 'Aad","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6000,"surah":89,"ayah":7,"key":"89:7","numberInSurah":"٧","text":"إِرَمَ ذَاتِ ٱلۡعِمَادِ","transliteration":"Irama thati alAAimadi","translation":"[With] Iram - who had lofty pillars","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6001,"surah":89,"ayah":8,"key":"89:8","numberInSurah":"٨","text":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ","transliteration":"Allatee lam yukhlaq mithluha fee albiladi","translation":"The likes of whom had never been created in the land","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6002,"surah":89,"ayah":9,"key":"89:9","numberInSurah":"٩","text":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ","transliteration":"Wathamooda allatheena jaboo alssakhra bialwadi","translation":"And [with] Thamud, who carved out the rocks in the valley","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6003,"surah":89,"ayah":10,"key":"89:10","numberInSurah":"١٠","text":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ","transliteration":"WafirAAawna thee alawtadi","translation":"And [with] Pharaoh, owner of the stakes","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6004,"surah":89,"ayah":11,"key":"89:11","numberInSurah":"١١","text":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ","transliteration":"Allatheena taghaw fee albiladi","translation":"[All of] whom oppressed within the lands","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6005,"surah":89,"ayah":12,"key":"89:12","numberInSurah":"١٢","text":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ","transliteration":"Faaktharoo feeha alfasada","translation":"And increased therein the corruption","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6006,"surah":89,"ayah":13,"key":"89:13","numberInSurah":"١٣","text":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ","transliteration":"Fasabba AAalayhim rabbuka sawta AAathabin","translation":"So your Lord poured upon them a scourge of punishment","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6007,"surah":89,"ayah":14,"key":"89:14","numberInSurah":"١٤","text":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ","transliteration":"Inna rabbaka labialmirsadi","translation":"Indeed, your Lord is in observation","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6008,"surah":89,"ayah":15,"key":"89:15","numberInSurah":"١٥","text":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ","transliteration":"Faamma alinsanu itha ma ibtalahu rabbuhu faakramahu wanaAAAAamahu fayaqoolu rabbee akramani","translation":"And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6009,"surah":89,"ayah":16,"key":"89:16","numberInSurah":"١٦","text":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ","transliteration":"Waamma itha ma ibtalahu faqadara AAalayhi rizqahu fayaqoolu rabbee ahanani","translation":"But when He tries him and restricts his provision, he says, \"My Lord has humiliated me","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6010,"surah":89,"ayah":17,"key":"89:17","numberInSurah":"١٧","text":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ","transliteration":"Kalla bal la tukrimoona alyateema","translation":"No! But you do not honor the orphan","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6011,"surah":89,"ayah":18,"key":"89:18","numberInSurah":"١٨","text":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","transliteration":"Wala tahaddoona AAala taAAami almiskeeni","translation":"And you do not encourage one another to feed the poor","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6012,"surah":89,"ayah":19,"key":"89:19","numberInSurah":"١٩","text":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا","transliteration":"Watakuloona altturatha aklan lamman","translation":"And you consume inheritance, devouring [it] altogether","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6013,"surah":89,"ayah":20,"key":"89:20","numberInSurah":"٢٠","text":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا","transliteration":"Watuhibboona almala hubban jamman","translation":"And you love wealth with immense love","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6014,"surah":89,"ayah":21,"key":"89:21","numberInSurah":"٢١","text":"كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا","transliteration":"Kalla itha dukkati alardu dakkan dakkan","translation":"No! When the earth has been leveled - pounded and crushed","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6015,"surah":89,"ayah":22,"key":"89:22","numberInSurah":"٢٢","text":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا","transliteration":"Wajaa rabbuka waalmalaku saffan saffan","translation":"And your Lord has come and the angels, rank upon rank","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6016,"surah":89,"ayah":23,"key":"89:23","numberInSurah":"٢٣","text":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","transliteration":"Wajeea yawmaithin bijahannama yawmaithin yatathakkaru alinsanu waanna lahu alththikra","translation":"And brought [within view], that Day, is Hell - that Day, man will remember, but what good to him will be the remembrance","page":593,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6017,"surah":89,"ayah":24,"key":"89:24","numberInSurah":"٢٤","text":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي","transliteration":"Yaqoolu ya laytanee qaddamtu lihayatee","translation":"He will say, \"Oh, I wish I had sent ahead [some good] for my life","page":594,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6018,"surah":89,"ayah":25,"key":"89:25","numberInSurah":"٢٥","text":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ","transliteration":"Fayawmaithin la yuAAaththibu AAathabahu ahadun","translation":"So on that Day, none will punish [as severely] as His punishment","page":594,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6019,"surah":89,"ayah":26,"key":"89:26","numberInSurah":"٢٦","text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ","transliteration":"Wala yoothiqu wathaqahu ahadun","translation":"And none will bind [as severely] as His binding [of the evildoers]","page":594,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6020,"surah":89,"ayah":27,"key":"89:27","numberInSurah":"٢٧","text":"يَـٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ","transliteration":"Ya ayyatuha alnnafsu almutmainnatu","translation":"[To the righteous it will be said], \"O reassured soul","page":594,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6021,"surah":89,"ayah":28,"key":"89:28","numberInSurah":"٢٨","text":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ","transliteration":"IrjiAAee ila rabbiki radiyatan mardiyyatan","translation":"Return to your Lord, well-pleased and pleasing [to Him]","page":594,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6022,"surah":89,"ayah":29,"key":"89:29","numberInSurah":"٢٩","text":"فَٱدۡخُلِي فِي عِبَٰدِي","transliteration":"Faodkhulee fee AAibadee","translation":"And enter among My [righteous] servants","page":594,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false},{"id":6023,"surah":89,"ayah":30,"key":"89:30","numberInSurah":"٣٠","text":"وَٱدۡخُلِي جَنَّتِي","transliteration":"Waodkhulee jannatee","translation":"And enter My Paradise","page":594,"juz":30,"hizb":60,"rubAlHizb":237,"ruku":531,"sajdah":false}]}
