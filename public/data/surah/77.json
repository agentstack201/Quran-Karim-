{"chapter":{"id":77,"name":"المُرسَلات","nameSimple":"المرسلات","transliteration":"Al-Mursalat","translation":"The Emissaries","revelation":"meccan","revelationOrder":33,"versesCount":50,"rukuCount":2,"firstVerseId":5623,"lastVerseId":5672,"startPage":580,"endPage":581,"startJuz":29,"endJuz":29,"hasBasmalah":true},"verses":[{"id":5623,"surah":77,"ayah":1,"key":"77:1","numberInSurah":"١","text":"وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا","transliteration":"Waalmursalati AAurfan","translation":"By those [winds] sent forth in gusts","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5624,"surah":77,"ayah":2,"key":"77:2","numberInSurah":"٢","text":"فَٱلۡعَٰصِفَٰتِ عَصۡفٗا","transliteration":"FaalAAasifati AAasfan","translation":"And the winds that blow violently","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5625,"surah":77,"ayah":3,"key":"77:3","numberInSurah":"٣","text":"وَٱلنَّـٰشِرَٰتِ نَشۡرٗا","transliteration":"Waalnnashirati nashran","translation":"And [by] the winds that spread [clouds]","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5626,"surah":77,"ayah":4,"key":"77:4","numberInSurah":"٤","text":"فَٱلۡفَٰرِقَٰتِ فَرۡقٗا","transliteration":"Faalfariqati farqan","translation":"And those [angels] who bring criterion","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5627,"surah":77,"ayah":5,"key":"77:5","numberInSurah":"٥","text":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا","transliteration":"Faalmulqiyati thikran","translation":"And those [angels] who deliver a message","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5628,"surah":77,"ayah":6,"key":"77:6","numberInSurah":"٦","text":"عُذۡرًا أَوۡ نُذۡرًا","transliteration":"AAuthran aw nuthran","translation":"As justification or warning","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5629,"surah":77,"ayah":7,"key":"77:7","numberInSurah":"٧","text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ","transliteration":"Innama tooAAadoona lawaqiAAun","translation":"Indeed, what you are promised is to occur","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5630,"surah":77,"ayah":8,"key":"77:8","numberInSurah":"٨","text":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ","transliteration":"Faitha alnnujoomu tumisat","translation":"So when the stars are obliterated","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5631,"surah":77,"ayah":9,"key":"77:9","numberInSurah":"٩","text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ","transliteration":"Waitha alssamao furijat","translation":"And when the heaven is opened","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5632,"surah":77,"ayah":10,"key":"77:10","numberInSurah":"١٠","text":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ","transliteration":"Waitha aljibalu nusifat","translation":"And when the mountains are blown away","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5633,"surah":77,"ayah":11,"key":"77:11","numberInSurah":"١١","text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ","transliteration":"Waitha alrrusulu oqqitat","translation":"And when the messengers' time has come","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5634,"surah":77,"ayah":12,"key":"77:12","numberInSurah":"١٢","text":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ","transliteration":"Liayyi yawmin ojjilat","translation":"For what Day was it postponed","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5635,"surah":77,"ayah":13,"key":"77:13","numberInSurah":"١٣","text":"لِيَوۡمِ ٱلۡفَصۡلِ","transliteration":"Liyawmi alfasli","translation":"For the Day of Judgement","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5636,"surah":77,"ayah":14,"key":"77:14","numberInSurah":"١٤","text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ","transliteration":"Wama adraka ma yawmu alfasli","translation":"And what can make you know what is the Day of Judgement","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5637,"surah":77,"ayah":15,"key":"77:15","numberInSurah":"١٥","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5638,"surah":77,"ayah":16,"key":"77:16","numberInSurah":"١٦","text":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ","transliteration":"Alam nuhliki alawwaleena","translation":"Did We not destroy the former peoples","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5639,"surah":77,"ayah":17,"key":"77:17","numberInSurah":"١٧","text":"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ","transliteration":"Thumma nutbiAAuhumu alakhireena","translation":"Then We will follow them with the later ones","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5640,"surah":77,"ayah":18,"key":"77:18","numberInSurah":"١٨","text":"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","transliteration":"Kathalika nafAAalu bialmujrimeena","translation":"Thus do We deal with the criminals","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5641,"surah":77,"ayah":19,"key":"77:19","numberInSurah":"١٩","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":580,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5642,"surah":77,"ayah":20,"key":"77:20","numberInSurah":"٢٠","text":"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ","transliteration":"Alam nakhluqkum min main maheenin","translation":"Did We not create you from a liquid disdained","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5643,"surah":77,"ayah":21,"key":"77:21","numberInSurah":"٢١","text":"فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ","transliteration":"FajaAAalnahu fee qararin makeenin","translation":"And We placed it in a firm lodging","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5644,"surah":77,"ayah":22,"key":"77:22","numberInSurah":"٢٢","text":"إِلَىٰ قَدَرٖ مَّعۡلُومٖ","transliteration":"Ila qadarin maAAloomin","translation":"For a known extent","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5645,"surah":77,"ayah":23,"key":"77:23","numberInSurah":"٢٣","text":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ","transliteration":"Faqadarna faniAAma alqadiroona","translation":"And We determined [it], and excellent [are We] to determine","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5646,"surah":77,"ayah":24,"key":"77:24","numberInSurah":"٢٤","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5647,"surah":77,"ayah":25,"key":"77:25","numberInSurah":"٢٥","text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا","transliteration":"Alam najAAali alarda kifatan","translation":"Have We not made the earth a container","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5648,"surah":77,"ayah":26,"key":"77:26","numberInSurah":"٢٦","text":"أَحۡيَآءٗ وَأَمۡوَٰتٗا","transliteration":"Ahyaan waamwatan","translation":"Of the living and the dead","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5649,"surah":77,"ayah":27,"key":"77:27","numberInSurah":"٢٧","text":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا","transliteration":"WajaAAalna feeha rawasiya shamikhatin waasqaynakum maan furatan","translation":"And We placed therein lofty, firmly set mountains and have given you to drink sweet water","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5650,"surah":77,"ayah":28,"key":"77:28","numberInSurah":"٢٨","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5651,"surah":77,"ayah":29,"key":"77:29","numberInSurah":"٢٩","text":"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","transliteration":"Intaliqoo ila ma kuntum bihi tukaththiboona","translation":"[They will be told], \"Proceed to that which you used to deny","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5652,"surah":77,"ayah":30,"key":"77:30","numberInSurah":"٣٠","text":"ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ","transliteration":"Intaliqoo ila thillin thee thalathi shuAAabin","translation":"Proceed to a shadow [of smoke] having three columns","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5653,"surah":77,"ayah":31,"key":"77:31","numberInSurah":"٣١","text":"لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ","transliteration":"La thaleelin wala yughnee mina allahabi","translation":"[But having] no cool shade and availing not against the flame","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5654,"surah":77,"ayah":32,"key":"77:32","numberInSurah":"٣٢","text":"إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ","transliteration":"Innaha tarmee bishararin kaalqasri","translation":"Indeed, it throws sparks [as huge] as a fortress","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5655,"surah":77,"ayah":33,"key":"77:33","numberInSurah":"٣٣","text":"كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ","transliteration":"Kaannahu jimalatun sufrun","translation":"As if they were yellowish [black] camels","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5656,"surah":77,"ayah":34,"key":"77:34","numberInSurah":"٣٤","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5657,"surah":77,"ayah":35,"key":"77:35","numberInSurah":"٣٥","text":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ","transliteration":"Hatha yawmu la yantiqoona","translation":"This is a Day they will not speak","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5658,"surah":77,"ayah":36,"key":"77:36","numberInSurah":"٣٦","text":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ","transliteration":"Wala yuthanu lahum fayaAAtathiroona","translation":"Nor will it be permitted for them to make an excuse","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5659,"surah":77,"ayah":37,"key":"77:37","numberInSurah":"٣٧","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5660,"surah":77,"ayah":38,"key":"77:38","numberInSurah":"٣٨","text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ","transliteration":"Hatha yawmu alfasli jamaAAnakum waalawwaleena","translation":"This is the Day of Judgement; We will have assembled you and the former peoples","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5661,"surah":77,"ayah":39,"key":"77:39","numberInSurah":"٣٩","text":"فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ","transliteration":"Fain kana lakum kaydun fakeedooni","translation":"So if you have a plan, then plan against Me","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5662,"surah":77,"ayah":40,"key":"77:40","numberInSurah":"٤٠","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":516,"sajdah":false},{"id":5663,"surah":77,"ayah":41,"key":"77:41","numberInSurah":"٤١","text":"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ","transliteration":"Inna almuttaqeena fee thilalin waAAuyoonin","translation":"Indeed, the righteous will be among shades and springs","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5664,"surah":77,"ayah":42,"key":"77:42","numberInSurah":"٤٢","text":"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ","transliteration":"Wafawakiha mimma yashtahoona","translation":"And fruits from whatever they desire","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5665,"surah":77,"ayah":43,"key":"77:43","numberInSurah":"٤٣","text":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ","transliteration":"Kuloo waishraboo haneean bima kuntum taAAmaloona","translation":"[Being told], \"Eat and drink in satisfaction for what you used to do","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5666,"surah":77,"ayah":44,"key":"77:44","numberInSurah":"٤٤","text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","transliteration":"Inna kathalika najzee almuhsineena","translation":"Indeed, We thus reward the doers of good","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5667,"surah":77,"ayah":45,"key":"77:45","numberInSurah":"٤٥","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5668,"surah":77,"ayah":46,"key":"77:46","numberInSurah":"٤٦","text":"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ","transliteration":"Kuloo watamattaAAoo qaleelan innakum mujrimoona","translation":"[O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5669,"surah":77,"ayah":47,"key":"77:47","numberInSurah":"٤٧","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5670,"surah":77,"ayah":48,"key":"77:48","numberInSurah":"٤٨","text":"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ","transliteration":"Waitha qeela lahumu irkaAAoo la yarkaAAoona","translation":"And when it is said to them, \"Bow [in prayer],\" they do not bow","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5671,"surah":77,"ayah":49,"key":"77:49","numberInSurah":"٤٩","text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","transliteration":"Waylun yawmaithin lilmukaththibeena","translation":"Woe, that Day, to the deniers","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false},{"id":5672,"surah":77,"ayah":50,"key":"77:50","numberInSurah":"٥٠","text":"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ","transliteration":"Fabiayyi hadeethin baAAdahu yuminoona","translation":"Then in what statement after the Qur'an will they believe","page":581,"juz":29,"hizb":58,"rubAlHizb":232,"ruku":517,"sajdah":false}]}
