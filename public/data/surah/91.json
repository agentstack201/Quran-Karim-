{"chapter":{"id":91,"name":"الشَّمس","nameSimple":"الشمس","transliteration":"Ash-Shams","translation":"The Sun","revelation":"meccan","revelationOrder":26,"versesCount":15,"rukuCount":1,"firstVerseId":6044,"lastVerseId":6058,"startPage":595,"endPage":595,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6044,"surah":91,"ayah":1,"key":"91:1","numberInSurah":"١","text":"وَٱلشَّمۡسِ وَضُحَىٰهَا","transliteration":"Waalshshamsi waduhaha","translation":"By the sun and its brightness","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6045,"surah":91,"ayah":2,"key":"91:2","numberInSurah":"٢","text":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","transliteration":"Waalqamari itha talaha","translation":"And [by] the moon when it follows it","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6046,"surah":91,"ayah":3,"key":"91:3","numberInSurah":"٣","text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","transliteration":"Waalnnahari itha jallaha","translation":"And [by] the day when it displays it","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6047,"surah":91,"ayah":4,"key":"91:4","numberInSurah":"٤","text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","transliteration":"Waallayli itha yaghshaha","translation":"And [by] the night when it covers it","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6048,"surah":91,"ayah":5,"key":"91:5","numberInSurah":"٥","text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","transliteration":"Waalssamai wama banaha","translation":"And [by] the sky and He who constructed it","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6049,"surah":91,"ayah":6,"key":"91:6","numberInSurah":"٦","text":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","transliteration":"Waalardi wama tahaha","translation":"And [by] the earth and He who spread it","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6050,"surah":91,"ayah":7,"key":"91:7","numberInSurah":"٧","text":"وَنَفۡسٖ وَمَا سَوَّىٰهَا","transliteration":"Wanafsin wama sawwaha","translation":"And [by] the soul and He who proportioned it","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6051,"surah":91,"ayah":8,"key":"91:8","numberInSurah":"٨","text":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","transliteration":"Faalhamaha fujooraha wataqwaha","translation":"And inspired it [with discernment of] its wickedness and its righteousness","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6052,"surah":91,"ayah":9,"key":"91:9","numberInSurah":"٩","text":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","transliteration":"Qad aflaha man zakkaha","translation":"He has succeeded who purifies it","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6053,"surah":91,"ayah":10,"key":"91:10","numberInSurah":"١٠","text":"وَقَدۡ خَابَ مَن دَسَّىٰهَا","transliteration":"Waqad khaba man dassaha","translation":"And he has failed who instills it [with corruption]","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6054,"surah":91,"ayah":11,"key":"91:11","numberInSurah":"١١","text":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ","transliteration":"Kaththabat thamoodu bitaghwaha","translation":"Thamud denied [their prophet] by reason of their transgression","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6055,"surah":91,"ayah":12,"key":"91:12","numberInSurah":"١٢","text":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","transliteration":"Ithi inbaAAatha ashqaha","translation":"When the most wretched of them was sent forth","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6056,"surah":91,"ayah":13,"key":"91:13","numberInSurah":"١٣","text":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","transliteration":"Faqala lahum rasoolu Allahi naqata Allahi wasuqyaha","translation":"And the messenger of Allah [Salih] said to them, \"[Do not harm] the she-camel of Allah or [prevent her from] her drink","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6057,"surah":91,"ayah":14,"key":"91:14","numberInSurah":"١٤","text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا","transliteration":"Fakaththaboohu faAAaqarooha fadamdama AAalayhim rabbuhum bithanbihim fasawwaha","translation":"But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them]","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false},{"id":6058,"surah":91,"ayah":15,"key":"91:15","numberInSurah":"١٥","text":"وَلَا يَخَافُ عُقۡبَٰهَا","transliteration":"Wala yakhafu AAuqbaha","translation":"And He does not fear the consequence thereof","page":595,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":533,"sajdah":false}]}
