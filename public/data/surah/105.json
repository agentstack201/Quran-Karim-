{"chapter":{"id":105,"name":"الفِيل","nameSimple":"الفيل","transliteration":"Al-Fil","translation":"The Elephant","revelation":"meccan","revelationOrder":19,"versesCount":5,"rukuCount":1,"firstVerseId":6189,"lastVerseId":6193,"startPage":601,"endPage":601,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6189,"surah":105,"ayah":1,"key":"105:1","numberInSurah":"١","text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ","transliteration":"Alam tara kayfa faAAala rabbuka biashabi alfeeli","translation":"Have you not considered, [O Muhammad], how your Lord dealt with the companions of the elephant","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":547,"sajdah":false},{"id":6190,"surah":105,"ayah":2,"key":"105:2","numberInSurah":"٢","text":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ","transliteration":"Alam yajAAal kaydahum fee tadleelin","translation":"Did He not make their plan into misguidance","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":547,"sajdah":false},{"id":6191,"surah":105,"ayah":3,"key":"105:3","numberInSurah":"٣","text":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ","transliteration":"Waarsala AAalayhim tayran ababeela","translation":"And He sent against them birds in flocks","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":547,"sajdah":false},{"id":6192,"surah":105,"ayah":4,"key":"105:4","numberInSurah":"٤","text":"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ","transliteration":"Tarmeehim bihijaratin min sijjeelin","translation":"Striking them with stones of hard clay","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":547,"sajdah":false},{"id":6193,"surah":105,"ayah":5,"key":"105:5","numberInSurah":"٥","text":"فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ","transliteration":"FajaAAalahum kaAAasfin makoolin","translation":"And He made them like eaten straw","page":601,"juz":30,"hizb":60,"rubAlHizb":240,"ruku":547,"sajdah":false}]}
