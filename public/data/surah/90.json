{"chapter":{"id":90,"name":"البَلَد","nameSimple":"البلد","transliteration":"Al-Balad","translation":"The City","revelation":"meccan","revelationOrder":35,"versesCount":20,"rukuCount":1,"firstVerseId":6024,"lastVerseId":6043,"startPage":594,"endPage":594,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":6024,"surah":90,"ayah":1,"key":"90:1","numberInSurah":"١","text":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","transliteration":"La oqsimu bihatha albaladi","translation":"I swear by this city, Makkah","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6025,"surah":90,"ayah":2,"key":"90:2","numberInSurah":"٢","text":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","transliteration":"Waanta hillun bihatha albaladi","translation":"And you, [O Muhammad], are free of restriction in this city","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6026,"surah":90,"ayah":3,"key":"90:3","numberInSurah":"٣","text":"وَوَالِدٖ وَمَا وَلَدَ","transliteration":"Wawalidin wama walada","translation":"And [by] the father and that which was born [of him]","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6027,"surah":90,"ayah":4,"key":"90:4","numberInSurah":"٤","text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","transliteration":"Laqad khalaqna alinsana fee kabadin","translation":"We have certainly created man into hardship","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6028,"surah":90,"ayah":5,"key":"90:5","numberInSurah":"٥","text":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ","transliteration":"Ayahsabu an lan yaqdira AAalayhi ahadun","translation":"Does he think that never will anyone overcome him","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6029,"surah":90,"ayah":6,"key":"90:6","numberInSurah":"٦","text":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا","transliteration":"Yaqoolu ahlaktu malan lubadan","translation":"He says, \"I have spent wealth in abundance","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6030,"surah":90,"ayah":7,"key":"90:7","numberInSurah":"٧","text":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","transliteration":"Ayahsabu an lam yarahu ahadun","translation":"Does he think that no one has seen him","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6031,"surah":90,"ayah":8,"key":"90:8","numberInSurah":"٨","text":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","transliteration":"Alam najAAal lahu AAaynayni","translation":"Have We not made for him two eyes","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6032,"surah":90,"ayah":9,"key":"90:9","numberInSurah":"٩","text":"وَلِسَانٗا وَشَفَتَيۡنِ","transliteration":"Walisanan washafatayni","translation":"And a tongue and two lips","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6033,"surah":90,"ayah":10,"key":"90:10","numberInSurah":"١٠","text":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","transliteration":"Wahadaynahu alnnajdayni","translation":"And have shown him the two ways","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6034,"surah":90,"ayah":11,"key":"90:11","numberInSurah":"١١","text":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","transliteration":"Fala iqtahama alAAaqabata","translation":"But he has not broken through the difficult pass","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6035,"surah":90,"ayah":12,"key":"90:12","numberInSurah":"١٢","text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ","transliteration":"Wama adraka ma alAAaqabatu","translation":"And what can make you know what is [breaking through] the difficult pass","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6036,"surah":90,"ayah":13,"key":"90:13","numberInSurah":"١٣","text":"فَكُّ رَقَبَةٍ","transliteration":"Fakku raqabatin","translation":"It is the freeing of a slave","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6037,"surah":90,"ayah":14,"key":"90:14","numberInSurah":"١٤","text":"أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ","transliteration":"Aw itAAamun fee yawmin thee masghabatin","translation":"Or feeding on a day of severe hunger","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6038,"surah":90,"ayah":15,"key":"90:15","numberInSurah":"١٥","text":"يَتِيمٗا ذَا مَقۡرَبَةٍ","transliteration":"Yateeman tha maqrabatin","translation":"An orphan of near relationship","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6039,"surah":90,"ayah":16,"key":"90:16","numberInSurah":"١٦","text":"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ","transliteration":"Aw miskeenan tha matrabatin","translation":"Or a needy person in misery","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6040,"surah":90,"ayah":17,"key":"90:17","numberInSurah":"١٧","text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ","transliteration":"Thumma kana mina allatheena amanoo watawasaw bialssabri watawasaw bialmarhamati","translation":"And then being among those who believed and advised one another to patience and advised one another to compassion","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6041,"surah":90,"ayah":18,"key":"90:18","numberInSurah":"١٨","text":"أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","transliteration":"Olaika ashabu almaymanati","translation":"Those are the companions of the right","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6042,"surah":90,"ayah":19,"key":"90:19","numberInSurah":"١٩","text":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","transliteration":"Waallatheena kafaroo biayatina hum ashabu almashamati","translation":"But they who disbelieved in Our signs - those are the companions of the left","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false},{"id":6043,"surah":90,"ayah":20,"key":"90:20","numberInSurah":"٢٠","text":"عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ","transliteration":"AAalayhim narun musadatun","translation":"Over them will be fire closed in","page":594,"juz":30,"hizb":60,"rubAlHizb":238,"ruku":532,"sajdah":false}]}
