{"chapter":{"id":84,"name":"الانشِقَاق","nameSimple":"الإنشقاق","transliteration":"Al-Inshiqaq","translation":"The Sundering","revelation":"meccan","revelationOrder":83,"versesCount":25,"rukuCount":1,"firstVerseId":5885,"lastVerseId":5909,"startPage":589,"endPage":589,"startJuz":30,"endJuz":30,"hasBasmalah":true},"verses":[{"id":5885,"surah":84,"ayah":1,"key":"84:1","numberInSurah":"١","text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","transliteration":"Itha alssamao inshaqqat","translation":"When the sky has split [open]","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5886,"surah":84,"ayah":2,"key":"84:2","numberInSurah":"٢","text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","transliteration":"Waathinat lirabbiha wahuqqat","translation":"And has responded to its Lord and was obligated [to do so]","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5887,"surah":84,"ayah":3,"key":"84:3","numberInSurah":"٣","text":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","transliteration":"Waitha alardu muddat","translation":"And when the earth has been extended","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5888,"surah":84,"ayah":4,"key":"84:4","numberInSurah":"٤","text":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","transliteration":"Waalqat ma feeha watakhallat","translation":"And has cast out that within it and relinquished [it]","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5889,"surah":84,"ayah":5,"key":"84:5","numberInSurah":"٥","text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","transliteration":"Waathinat lirabbiha wahuqqat","translation":"And has responded to its Lord and was obligated [to do so]","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5890,"surah":84,"ayah":6,"key":"84:6","numberInSurah":"٦","text":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ","transliteration":"Ya ayyuha alinsanu innaka kadihun ila rabbika kadhan famulaqeehi","translation":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5891,"surah":84,"ayah":7,"key":"84:7","numberInSurah":"٧","text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","transliteration":"Faama man ootiya kitabahu biyameenihi","translation":"Then as for he who is given his record in his right hand","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5892,"surah":84,"ayah":8,"key":"84:8","numberInSurah":"٨","text":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا","transliteration":"Fasawfa yuhasabu hisaban yaseeran","translation":"He will be judged with an easy account","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5893,"surah":84,"ayah":9,"key":"84:9","numberInSurah":"٩","text":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا","transliteration":"Wayanqalibu ila ahlihi masrooran","translation":"And return to his people in happiness","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5894,"surah":84,"ayah":10,"key":"84:10","numberInSurah":"١٠","text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","transliteration":"Waamma man ootiya kitabahu waraa thahrihi","translation":"But as for he who is given his record behind his back","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5895,"surah":84,"ayah":11,"key":"84:11","numberInSurah":"١١","text":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا","transliteration":"Fasawfa yadAAoo thubooran","translation":"He will cry out for destruction","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5896,"surah":84,"ayah":12,"key":"84:12","numberInSurah":"١٢","text":"وَيَصۡلَىٰ سَعِيرًا","transliteration":"Wayasla saAAeeran","translation":"And [enter to] burn in a Blaze","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5897,"surah":84,"ayah":13,"key":"84:13","numberInSurah":"١٣","text":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","transliteration":"Innahu kana fee ahlihi masrooran","translation":"Indeed, he had [once] been among his people in happiness","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5898,"surah":84,"ayah":14,"key":"84:14","numberInSurah":"١٤","text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","transliteration":"Innahu thanna an lan yahoora","translation":"Indeed, he had thought he would never return [to Allah]","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5899,"surah":84,"ayah":15,"key":"84:15","numberInSurah":"١٥","text":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا","transliteration":"Bala inna rabbahu kana bihi baseeran","translation":"But yes! Indeed, his Lord was ever of him, Seeing","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5900,"surah":84,"ayah":16,"key":"84:16","numberInSurah":"١٦","text":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ","transliteration":"Fala oqsimu bialshshafaqi","translation":"So I swear by the twilight glow","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5901,"surah":84,"ayah":17,"key":"84:17","numberInSurah":"١٧","text":"وَٱلَّيۡلِ وَمَا وَسَقَ","transliteration":"Waallayli wama wasaqa","translation":"And [by] the night and what it envelops","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5902,"surah":84,"ayah":18,"key":"84:18","numberInSurah":"١٨","text":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","transliteration":"Waalqamari itha ittasaqa","translation":"And [by] the moon when it becomes full","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5903,"surah":84,"ayah":19,"key":"84:19","numberInSurah":"١٩","text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ","transliteration":"Latarkabunna tabaqan AAan tabaqin","translation":"[That] you will surely experience state after state","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5904,"surah":84,"ayah":20,"key":"84:20","numberInSurah":"٢٠","text":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","transliteration":"Fama lahum la yuminoona","translation":"So what is [the matter] with them [that] they do not believe","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5905,"surah":84,"ayah":21,"key":"84:21","numberInSurah":"٢١","text":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","transliteration":"Waitha quria AAalayhimu alquranu la yasjudoona","translation":"And when the Qur'an is recited to them, they do not prostrate [to Allah]","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":true},{"id":5906,"surah":84,"ayah":22,"key":"84:22","numberInSurah":"٢٢","text":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","transliteration":"Bali allatheena kafaroo yukaththiboona","translation":"But those who have disbelieved deny","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5907,"surah":84,"ayah":23,"key":"84:23","numberInSurah":"٢٣","text":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","transliteration":"WaAllahu aAAlamu bima yooAAoona","translation":"And Allah is most knowing of what they keep within themselves","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5908,"surah":84,"ayah":24,"key":"84:24","numberInSurah":"٢٤","text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","transliteration":"Fabashshirhum biAAathabin aleemin","translation":"So give them tidings of a painful punishment","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false},{"id":5909,"surah":84,"ayah":25,"key":"84:25","numberInSurah":"٢٥","text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ","transliteration":"Illa allatheena amanoo waAAamiloo alssalihati lahum ajrun ghayru mamnoonin","translation":"Except for those who believe and do righteous deeds. For them is a reward uninterrupted","page":589,"juz":30,"hizb":59,"rubAlHizb":236,"ruku":526,"sajdah":false}]}
